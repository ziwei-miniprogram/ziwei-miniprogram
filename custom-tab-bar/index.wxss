.tab-bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  height: 110rpx;
  background: #ffffff;
  display: flex;
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -4rpx 20rpx rgba(40,33,20,.07);
  z-index: 999;
  transition: background .35s ease;
}
.tab-bar.dark {
  background: #0B1426;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,.5);
}
.tab-bar.dark .label { color: #9da9bd; }
.tab-bar.dark .tab-bar-item.center .plus-icon { box-shadow: 0 10rpx 24rpx rgba(0,0,0,.5); }
.tab-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
}
.tab-bar-item .tab-icon { width: 44rpx; height: 44rpx; }
.tab-bar-item .icon-wrap { position: relative; display: flex; align-items: center; justify-content: center; }
.tab-bar-item .label { margin-top: 6rpx; }
.tab-bar-item.center { position: relative; }
.tab-bar-item.center .plus-icon {
  width: 92rpx; height: 92rpx; border-radius: 50%;
  margin-top: -44rpx;
  border: 6rpx solid #fff;
  box-shadow: 0 10rpx 24rpx rgba(200,163,90,.45);
}
.tab-bar-item.center .center-label { color: #c8a35a; font-weight: 600; margin-top: 4rpx; }
