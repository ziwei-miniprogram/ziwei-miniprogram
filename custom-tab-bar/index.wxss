.tab-bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  height: 110rpx;
  background: #ffffff;
  display: flex;
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -4rpx 20rpx rgba(40,33,20,.07);
  z-index: 999;
  transition: background .35s ease;
}
.tab-bar.dark {
  background: #0B1426;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,.5);
}
.tab-bar.dark .label { color: #9da9bd; }
.tab-bar.dark .tab-bar-item.center .plus { box-shadow: 0 10rpx 24rpx rgba(0,0,0,.5); }
.tab-bar.dark .badge { box-shadow: 0 2rpx 6rpx rgba(0,0,0,.4); }
.tab-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
}
.tab-bar-item .icon { font-size: 40rpx; line-height: 1; }
.tab-bar-item .icon-wrap { position: relative; display: flex; align-items: center; justify-content: center; }
.tab-bar-item .badge {
  position: absolute; top: -10rpx; right: -14rpx;
  min-width: 30rpx; height: 30rpx; padding: 0 6rpx;
  border-radius: 999rpx; background: #e0796f; color: #fff;
  font-size: 18rpx; line-height: 30rpx; text-align: center;
  box-shadow: 0 2rpx 6rpx rgba(224,121,111,.5);
}
.tab-bar-item .label { margin-top: 6rpx; }
.tab-bar-item.center { position: relative; }
.tab-bar-item.center .plus {
  width: 96rpx; height: 96rpx; border-radius: 50%;
  margin-top: -46rpx;
  background: linear-gradient(140deg, #c8a35a, #e0c489);
  color: #fff; font-size: 52rpx; font-weight: 300;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 10rpx 24rpx rgba(200,163,90,.45);
  border: 6rpx solid #fff;
}
