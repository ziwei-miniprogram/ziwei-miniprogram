<view class="tab-bar {{theme}}">
  <view
    wx:for="{{list}}"
    wx:key="text"
    class="tab-bar-item {{item.center ? 'center' : ''}}"
    data-item="{{item}}"
    bindtap="switchTab"
  >
    <block wx:if="{{item.center}}">
      <view class="plus">✚</view>
    </block>
    <block wx:else>
      <view class="icon-wrap">
        <view class="icon">{{item.icon}}</view>
        <view class="badge" wx:if="{{item.text==='消息' && unread>0}}">{{unread>99?'99+':unread}}</view>
      </view>
      <view class="label" style="color: {{selected === item.tabIndex ? selectedColor : color}}">{{item.text}}</view>
    </block>
  </view>
</view>
<!-- 常驻心灯浮标：自动覆盖四个 tab 页 -->
<heart-lamp theme="{{theme}}" />
