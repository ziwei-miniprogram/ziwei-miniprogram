<view class="tab-bar {{theme}}">
  <view
    wx:for="{{list}}"
    wx:key="text"
    class="tab-bar-item {{item.center ? 'center' : ''}}"
    data-item="{{item}}"
    bindtap="switchTab"
  >
    <block wx:if="{{item.center}}">
      <image class="plus-icon" src="{{item.iconCenter}}" mode="aspectFit" />
      <view class="label center-label">{{item.text}}</view>
    </block>
    <block wx:else>
      <view class="icon-wrap">
        <image class="tab-icon" src="{{selected === item.tabIndex ? item.iconActive : item.icon}}" mode="aspectFit" />
      </view>
      <view class="label" style="color: {{selected === item.tabIndex ? selectedColor : color}}">{{item.text}}</view>
    </block>
  </view>
</view>
<!-- 常驻心灯浮标：自动覆盖 tab 页 -->
<heart-lamp theme="{{theme}}" />

<!-- 惊喜盲盒：每次打开小程序时的礼物开启动画 -->
<surprise-box
  wx:if="{{surprise}}"
  visible="{{surprise}}"
  bind:claim="onSurpriseClaim"
  bind:view="onSurpriseView"
  bind:close="onSurpriseClose"
/>
