/* 惊喜盲盒：自包含样式，令牌驱动，明暗自适应；尊重「减少动态效果」。 */
.sb-mask {
  position: fixed; inset: 0; z-index: 1000;
  background: rgba(11, 20, 38, .46);
  display: flex; align-items: center; justify-content: center;
  animation: sbFade .3s ease;
}
@keyframes sbFade { from { opacity: 0; } to { opacity: 1; } }

.sb-card {
  position: relative; width: 600rpx; padding: 56rpx 44rpx 48rpx;
  background: var(--card, #fff); border-radius: var(--radius-lg, 40rpx);
  box-shadow: var(--shadow-1, 0 2rpx 8rpx rgba(0,0,0,.05)), var(--shadow-2, 0 14rpx 36rpx rgba(0,0,0,.18));
  text-align: center; overflow: hidden;
  animation: sbPop .5s cubic-bezier(.23, 1, .32, 1);
}
@keyframes sbPop { 0% { transform: scale(.8); opacity: 0; } 60% { transform: scale(1.04); opacity: 1; } 100% { transform: scale(1); opacity: 1; } }

/* —— 闭合礼盒 —— */
.sb-closed { display: flex; flex-direction: column; align-items: center; }
.sb-box { position: relative; width: 240rpx; height: 200rpx; margin-top: 8rpx; }
.sb-body {
  position: absolute; left: 20rpx; bottom: 0; width: 200rpx; height: 130rpx;
  background: linear-gradient(160deg, #1b2a4a, #0B1426); border-radius: 14rpx;
  box-shadow: inset 0 0 0 2rpx rgba(200,163,90,.5);
}
.sb-rib-v {
  position: absolute; left: 50%; top: 0; width: 28rpx; height: 200rpx;
  transform: translateX(-50%); z-index: 3;
  background: linear-gradient(180deg, #e6c789, #c79a4e);
}
.sb-lid {
  position: absolute; left: 8rpx; top: 30rpx; width: 224rpx; height: 44rpx; z-index: 2;
  background: linear-gradient(160deg, #24365c, #14233f); border-radius: 12rpx;
  box-shadow: inset 0 0 0 2rpx rgba(200,163,90,.6);
  transform-origin: 50% 100%; transition: transform .5s cubic-bezier(.3,1.2,.5,1);
}
.sb-lid-bow {
  position: absolute; left: 50%; top: 18rpx; width: 56rpx; height: 40rpx; z-index: 4;
  transform: translateX(-50%); border-radius: 50% 50% 50% 50%;
  background: radial-gradient(circle at 50% 40%, #f0d49a, #c79a4e);
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,.3);
  transition: transform .5s ease;
}
.phase-opening .sb-lid { transform: translateY(-46rpx) rotate(-8deg); }
.phase-opening .sb-lid-bow { transform: translate(-50%, -52rpx) scale(1.1); }

.sb-hint {
  margin-top: 28rpx; font-size: 32rpx; font-weight: 700; color: var(--gold-deep, #8a6a2a);
  letter-spacing: 1rpx;
}
.sb-sub { margin-top: 10rpx; font-size: 22rpx; color: var(--fg-2, #998f80); }

/* —— 开启星辉粒子 —— */
.sb-burst { position: absolute; left: 50%; top: 38%; width: 0; height: 0; z-index: 1; }
.sb-sp {
  position: absolute; left: 0; top: 0; width: 12rpx; height: 12rpx; border-radius: 50%;
  background: radial-gradient(circle, #fff 0%, var(--gold, #c8a35a) 60%, transparent 72%);
  box-shadow: 0 0 12rpx var(--gold, #c8a35a);
  animation: sbFly .9s cubic-bezier(.18,.7,.3,1) forwards;
}
@keyframes sbFly {
  0% { transform: translate(0,0) scale(.3); opacity: 0; }
  20% { opacity: 1; }
  100% { transform: translate(var(--dx), var(--dy)) scale(1); opacity: 0; }
}

/* —— 揭晓卡 —— */
.sb-reveal { position: relative; z-index: 2; }
.sb-glow {
  position: absolute; top: -120rpx; right: -80rpx; width: 320rpx; height: 320rpx; border-radius: 50%;
  background: radial-gradient(circle, rgba(200,163,90,.38), transparent 70%);
}
.sb-kicker {
  font-size: 22rpx; color: var(--gold-deep, #8a6a2a); letter-spacing: 1rpx;
  border: 1rpx solid rgba(200,163,90,.4); border-radius: 999rpx;
  display: inline-block; padding: 6rpx 18rpx;
}
.sb-mansion {
  margin-top: 22rpx; font-size: 48rpx; font-weight: 700; color: var(--fg, #2b2622);
  line-height: 1.3;
}
.sb-line { margin-top: 16rpx; font-size: 28rpx; line-height: 1.8; color: var(--fg, #2b2622); }
.sb-season { margin-top: 14rpx; font-size: 24rpx; line-height: 1.7; color: var(--fg-3, #6b6457); }
.sb-lucky { margin-top: 20rpx; font-size: 26rpx; color: var(--fg-3, #6b6457); }
.sb-lucky-t { color: var(--gold-deep, #8a6a2a); font-weight: 600; }
.sb-reward { margin-top: 18rpx; font-size: 28rpx; color: var(--fg, #2b2622); }
.sb-reward-n { color: var(--gold-deep, #8a6a2a); font-weight: 700; }
.sb-acts { margin-top: 32rpx; display: flex; flex-direction: column; gap: 16rpx; }
.sb-btn {
  background: var(--gold-grad, linear-gradient(135deg, #d8b876, #b98e44));
  color: #3a2c10; border-radius: 999rpx; padding: 22rpx; font-size: 30rpx; font-weight: 700;
}
.sb-btn.ghost {
  background: transparent; color: var(--gold-deep, #8a6a2a);
  border: 2rpx solid var(--gold, #c8a35a);
}
.sb-btn:active { filter: brightness(.96); }
.sb-close { margin-top: 20rpx; font-size: 22rpx; color: var(--fg-2, #998f80); }

@media (prefers-reduced-motion: reduce) {
  .sb-mask, .sb-card, .sb-sp, .sb-lid, .sb-lid-bow { animation: none !important; transition: none !important; }
  .sb-sp { opacity: 0; }
}
