<view class="loop-wrap" wx:if="{{items.length}}">
  <view class="loop-title" wx:if="{{title}}">{{title}}</view>
  <view class="loop-row">
    <button class="loop-chip" wx:for="{{items}}" wx:key="url"
      data-url="{{item.url}}" bindtap="onTap" hover-class="lc-hover">
      <astro class="lc-ic" name="{{item.icon}}" size="26" theme="{{theme}}"/>
      <text class="lc-tx">{{item.label}}</text>
    </button>
  </view>
</view>
