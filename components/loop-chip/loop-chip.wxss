/* loop-chip：页底下一步芯片，令牌驱动，明暗自适应（解 B4 叶子页死胡同） */
.loop-wrap { margin: 28rpx 24rpx 8rpx; }
.loop-title { font-size: 24rpx; color: var(--fg-2); margin: 4rpx 0 14rpx; }
.loop-row { display: flex; flex-wrap: wrap; gap: 16rpx; }
.loop-chip {
  display: inline-flex; align-items: center; gap: 10rpx;
  padding: 18rpx 26rpx;
  background: var(--bg-elev);
  border: 1rpx solid var(--loop-chip-border, rgba(200,163,90,.4));
  border-radius: 999rpx;
  font-size: 26rpx; color: var(--loop-chip-fg, var(--fg));
  line-height: 1.2; margin: 0;
}
.loop-chip::after { border: none; } /* 去掉 button 默认边框 */
.lc-hover { transform: scale(.96); background: var(--gold-soft); }
.lc-ic { font-size: 30rpx; }
.lc-tx { font-weight: 600; }
