/* 二十八宿星图 */
.sm {
  margin: 20rpx 0;
  background: var(--card, #fff);
  border: 1rpx solid var(--border, rgba(138,127,109,.18));
  border-radius: 24rpx;
  padding: 24rpx 22rpx;
  box-shadow: 0 4rpx 18rpx rgba(40,33,20,.05);
}
.sm-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 16rpx; }
.sm-t { font-size: 28rpx; font-weight: 700; color: var(--gold-deep, #8a6a2a); }
.sm-s { font-size: 22rpx; color: var(--fg-2, #998f80); }
.sm-groups { display: flex; flex-direction: column; gap: 18rpx; }
.sm-group { display: flex; align-items: center; gap: 14rpx; }
.sm-gname { width: 132rpx; flex: none; font-size: 22rpx; color: var(--fg-3, #6b6457); text-align: right; }
.sm-stars { flex: 1; display: flex; flex-wrap: wrap; gap: 12rpx; }
.sm-star {
  width: 64rpx; height: 64rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  background: var(--bg-elev, #fffdf8);
  border: 1rpx solid var(--border, rgba(138,127,109,.18));
  color: var(--fg-2, #998f80);
  transition: all .3s ease;
}
.sm-char { font-size: 28rpx; font-family: "Songti SC", serif; }
.sm-star.on {
  background: radial-gradient(circle at 50% 40%, #f6e3b0, #c8a35a 70%);
  color: #3a2c10;
  border-color: #e0c489;
  box-shadow: 0 0 16rpx rgba(200,163,90,.6);
}
.sm-star.sel {
  transform: scale(1.12);
  border-color: #c8a35a;
}
.sm-cap {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--gold-deep, #8a6a2a);
  text-align: center;
  background: var(--gold-soft, rgba(200,163,90,.12));
  border-radius: 14rpx;
  padding: 12rpx 16rpx;
}
/* 暗色夜灯 */
.sm.dark .sm-star { background: #16223c; border-color: rgba(200,180,140,.18); color: #7e8aa0; }
.sm.dark .sm-star.on {
  background: radial-gradient(circle at 50% 40%, #f0d49a, #d9b66a 70%);
  color: #2a200a;
  box-shadow: 0 0 18rpx rgba(217,182,106,.55);
}

@media (prefers-reduced-motion: reduce) {
  .sm-star { transition: none !important; }
}
