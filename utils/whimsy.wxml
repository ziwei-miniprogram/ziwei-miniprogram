<!-- utils/whimsy.wxml — 共享愉悦浮层模板 -->
<!-- 用法：<import src="/utils/whimsy.wxml"/> 后，在页面根视图内放 <template is="whimsyFx"/> -->
<template name="whimsyFx">
  <!-- 功德星光浮层：固定全屏、不拦截点击 -->
  <view class="fx-layer">
    <view wx:for="{{fx}}" wx:key="id" class="fx-item" style="left:{{item.x}}">
      <text class="fx-emoji">{{item.emoji}}</text>
      <text class="fx-text">{{item.text}}</text>
    </view>
    <!-- 星屑分型微交互粒子 -->
    <view wx:for="{{dust}}" wx:key="id" class="fx-dust"
      style="left:{{item.x}};top:{{item.y}};--dx:{{item.dx}}rpx;--dy:{{item.dy}}rpx;"></view>
  </view>

  <!-- 晋阶庆祝卡 -->
  <view wx:if="{{levelUp}}" class="lu-mask">
    <view class="lu-card">
      <view class="lu-emoji">🏅</view>
      <view class="lu-title">功德圆满 · 晋阶</view>
      <view class="lu-name serif">{{levelUp.name}}</view>
      <view class="lu-sub">星野因你，又明亮一分</view>
    </view>
  </view>

  <!-- 彩蛋：星河贯通（彩虹星覆盖层）-->
  <view wx:if="{{rainbow}}" class="rainbow-overlay"></view>
</template>
