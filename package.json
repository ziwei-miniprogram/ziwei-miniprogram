{
  "name": "ziwei-miniprogram",
  "version": "1.0.0",
  "private": true,
  "description": "星野漫游小程序 — 代码质量门禁（ESLint 静态检查 + Jest 单元测试 + 静态编译校验）",
  "scripts": {
    "lint": "eslint \"pages/**/*.js\" \"utils/**/*.js\" \"custom-tab-bar/**/*.js\" \"components/**/*.js\"",
    "test": "jest",
    "validate": "node scripts/validate-mp.js",
    "prepare": "husky"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^17.3.0"
  },
  "jest": {
    "collectCoverageFrom": ["utils/**/*.js"],
    "coverageThreshold": {
      "./utils/anchor.js": { "statements": 90, "branches": 85, "functions": 95, "lines": 90 },
      "./utils/censor.js": { "statements": 95, "branches": 95, "functions": 95, "lines": 95 },
      "./utils/whimsy.js": { "statements": 85, "branches": 80, "functions": 90, "lines": 85 },
      "./utils/lunar.js": { "statements": 95, "branches": 90, "functions": 95, "lines": 95 },
      "./utils/mock.js": { "statements": 100, "branches": 100, "functions": 100, "lines": 100 },
      "./utils/social.js": { "statements": 95, "branches": 88, "functions": 95, "lines": 95 }
    }
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "jest --bail --findRelatedTests"
    ]
  }
}
