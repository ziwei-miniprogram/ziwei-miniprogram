APP_NAME=星野漫游后台
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# 数据库（MySQL / PostgreSQL 均可；功德/UGC 全局视图）
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ziwei_admin
DB_USERNAME=root
DB_PASSWORD=

# 小程序 API 鉴权（Sanctum token，P2 真实 API 对接时启用）
SANCTUM_GUARD=web

# 后台会话
SESSION_DRIVER=database
SESSION_LIFETIME=120

# 合规：功德虚拟、不可提现（服务端强制）
MERIT_REDEEMABLE=false
