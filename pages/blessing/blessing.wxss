.tpls { display: flex; flex-wrap: wrap; margin-top: 12rpx; }
.tpl {
  background: var(--bg-elev); color: var(--fg-2);
  padding: 12rpx 22rpx; border-radius: 999rpx;
  font-size: 26rpx; margin: 8rpx 12rpx 0 0;
}
.tpl.on {
  background: linear-gradient(135deg, #e0c489, var(--gold));
  color: #fff;
}
.tx {
  width: 100%; height: 140rpx; background: var(--bg-elev); color: var(--fg);
  border-radius: 14rpx; padding: 18rpx; margin-top: 12rpx;
  font-size: 28rpx; box-sizing: border-box;
}
.preview { display: flex; flex-direction: column; align-items: center; }
.cv { width: 300px; height: 400px; border-radius: 16rpx; }
