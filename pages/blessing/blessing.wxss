/* 祝福卡 · 方向 B：大留白 / 单列 / 细金线 / 无卡片底色 */
.page { padding: 0 32rpx 60rpx; }

.sec { margin-top: 44rpx; }
.s-h { font-size: 22rpx; letter-spacing: 2rpx; color: var(--gold-deep); margin-bottom: 18rpx; }

.tpls { display: flex; flex-wrap: wrap; gap: 14rpx; }
.tpl {
  display: flex; align-items: center; gap: 10rpx;
  background: transparent; color: var(--fg-2);
  border: 1rpx solid var(--border); border-radius: 999rpx;
  padding: 14rpx 26rpx; font-size: 26rpx;
}
.tpl.on { border-color: var(--gold); color: var(--gold-deep); font-weight: 600; }
.tpl-ic { width: 26px; height: 26px; display: flex; align-items: center; justify-content: center; flex: none; }

.tx {
  width: 100%; height: 150rpx; background: transparent; color: var(--fg);
  border: 1rpx solid var(--border); border-radius: 14rpx;
  padding: 20rpx; box-sizing: border-box;
  font-size: 28rpx; line-height: 1.7;
}

.preview { display: flex; flex-direction: column; align-items: center; margin-top: 10rpx; }
.cv { width: 300px; height: 400px; }
.cv-note { margin-top: 18rpx; font-size: 22rpx; color: var(--fg-3, var(--fg-2)); letter-spacing: 1rpx; }

.btn {
  margin-top: 48rpx; height: 96rpx; line-height: 96rpx; text-align: center;
  border: 1rpx solid var(--gold); border-radius: 999rpx;
  color: var(--gold-deep); font-size: 30rpx; letter-spacing: 2rpx;
  background: transparent;
}
