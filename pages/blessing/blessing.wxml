<import src="/utils/whimsy.wxml"/>
<view class="page {{theme}}">
  <view class="b-head">
    <view class="u-eyebrow">寄一段祝福</view>
    <view class="u-h2">祝福卡</view>
    <view class="u-lede">选节令 · 写祝语 · 生成一张可分享的星野卡面</view>
  </view>
  <view class="hair"></view>

  <view class="sec">
    <view class="s-h">① 选择节令</view>
    <view class="tpls">
      <view wx:for="{{templates}}" wx:key="key"
        class="tpl {{tpl === index ? 'on' : ''}}"
        data-index="{{index}}" bindtap="pickTpl">
        <astro class="tpl-ic" name="{{item.icon}}" size="26" theme="{{theme}}"/>
        <text>{{item.name}}</text>
      </view>
    </view>
  </view>

  <view class="sec">
    <view class="s-h">② 祝福文案</view>
    <textarea class="tx" value="{{text}}" bindinput="onText" maxlength="40" placeholder="写下你的祝福" />
  </view>

  <view class="sec">
    <view class="s-h">③ 背景音乐</view>
    <view class="tpls">
      <view wx:for="{{musics}}" wx:key="*this"
        class="tpl {{music === index ? 'on' : ''}}"
        data-index="{{index}}" bindtap="pickMusic">
        <text>{{item}}</text>
      </view>
    </view>
  </view>

  <view class="hair"></view>

  <view class="preview">
    <canvas type="2d" id="cv" class="cv"></canvas>
    <view class="cv-note">预览 · 正式导出为 MP4 需云端合成</view>
  </view>

  <view class="btn" bindtap="generate">生成并分享</view>
</view>
<template is="whimsyFx"/>
<view class="disclaimer">温馨提示：本平台星象、抽签、卡牌等内容均为传统文化与心理慰藉的娱乐参考，不预示吉凶、不构成任何专业建议，请勿迷信。如遇情绪困扰，请寻求专业帮助。</view>
