.page { padding: 0 0 40rpx; background: var(--bg); }
.seg { display: flex; gap: 40rpx; padding: 24rpx 36rpx 20rpx; }
.seg .s { font-size: 32rpx; color: var(--fg-2); position: relative; padding-bottom: 10rpx; }
.seg .s.on { color: var(--fg); font-weight: 700; }
.seg .s.on::after { content: ""; position: absolute; left: 50%; bottom: 0; transform: translateX(-50%); width: 36rpx; height: 6rpx; border-radius: 6rpx; background: var(--gold); }

.chat { display: flex; align-items: center; gap: 20rpx; padding: 26rpx 32rpx; border-bottom: 1rpx solid var(--border); position: relative; }
.chat .av { width: 84rpx; height: 84rpx; border-radius: 50%; background: linear-gradient(135deg, var(--gold), #e0c489); display: flex; align-items: center; justify-content: center; color: #fff; font-size: 32rpx; }
.c-body { flex: 1; }
.c-top { display: flex; justify-content: space-between; }
.c-name { font-size: 30rpx; font-weight: 600; color: var(--fg); }
.c-time { font-size: 22rpx; color: var(--fg-2); }
.c-last { font-size: 25rpx; color: var(--fg-2); margin-top: 8rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.unread { min-width: 34rpx; height: 34rpx; border-radius: 999rpx; background: var(--danger); color: #fff; font-size: 20rpx; display: flex; align-items: center; justify-content: center; padding: 0 8rpx; }

.notice { display: flex; align-items: center; gap: 20rpx; padding: 26rpx 32rpx; border-bottom: 1rpx solid var(--border); }
.n-icon { width: 72rpx; height: 72rpx; border-radius: 50%; background: var(--bg-elev); display: flex; align-items: center; justify-content: center; }
.n-glyph { font-size: 32rpx; color: var(--gold-deep); }
.n-body { flex: 1; }
.n-text { font-size: 27rpx; color: var(--fg); line-height: 1.5; }
.n-time { font-size: 22rpx; color: var(--fg-2); margin-top: 6rpx; }

/* 方向 B：本页 .page 无侧边距，页头三段式与细线单独补边距 */
.tips { padding: 0 32rpx; }
.b-head { padding: 0 32rpx; }
.hair { margin: 14rpx 32rpx 6rpx; }
.merit-item { display: flex; align-items: center; gap: 18rpx; padding: 20rpx 32rpx; }
.merit-item.link { cursor: pointer; }
.merit-item.link:active { background: var(--bg-elev); }
.merit-item .m-arrow { color: var(--gold-deep); font-size: 32rpx; margin-left: 4rpx; }
.m-dot { width: 16rpx; height: 16rpx; border-radius: 50%; background: var(--gold); }
.m-text { flex: 1; font-size: 26rpx; color: var(--fg-3); }
.m-time { font-size: 22rpx; color: var(--fg-2); }
