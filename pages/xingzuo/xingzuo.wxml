<view class="page {{theme}} container">
  <view class="hd">
    <view class="h-t serif">星座测试</view>
    <view class="h-s">今日运势 · 娱乐化参考</view>
  </view>

  <view class="card">
    <view class="d-form">
      <view class="fld"><text class="lab">你的星座</text><picker class="fi" mode="selector" range="{{signs}}" value="{{sIndex}}" bindchange="onS"><view class="fi-txt">{{signs[sIndex]}}</view></picker></view>
      <view class="btn" bindtap="run">抽取今日运势</view>
    </view>
  </view>

  <block wx:if="{{result}}">
    <view class="card">
      <view class="star-hero">
        <view class="sh-t serif">{{result.sign}}座</view>
        <view class="sh-s">今日星象 · 娱乐参考</view>
      </view>
      <view class="xz-rate"><text>综合运势</text><text class="stars">{{result.starsAll}}</text></view>
      <view class="xz-rate"><text>爱情</text><text class="stars">{{result.starsLove}}</text></view>
      <view class="xz-rate"><text>事业</text><text class="stars">{{result.starsCareer}}</text></view>
      <view class="xz-rate"><text>健康</text><text class="stars">{{result.starsHealth}}</text></view>
      <view class="xz-line">{{result.line}}</view>
    </view>
  </block>

  <view class="disclaimer">星座运势为娱乐化内容，由程序随机生成，不预示吉凶、不构成任何专业建议。</view>
</view>
<heart-lamp />
