<view class="page {{theme}} container">
  <view class="hd">
    <view class="h-t serif">八字命理</view>
    <view class="h-s">四柱排盘 · 五行强弱 · 传统文化娱乐参考</view>
  </view>

  <view class="card">
    <view class="d-form">
      <view class="fld"><text class="lab">出生年份</text><input class="fi" type="number" placeholder="如 1995" value="{{y}}" bindinput="onY" /></view>
      <view class="fld"><text class="lab">出生月份</text><input class="fi" type="number" placeholder="1 - 12" value="{{m}}" bindinput="onM" /></view>
      <view class="fld"><text class="lab">出生日</text><input class="fi" type="number" placeholder="1 - 31" value="{{d}}" bindinput="onD" /></view>
      <view class="fld"><text class="lab">出生时辰</text><picker class="fi" mode="selector" range="{{hours}}" value="{{hIndex}}" bindchange="onH"><view class="fi-txt">{{hours[hIndex]}}</view></picker></view>
      <view class="btn" bindtap="run">排四柱 · 看我的五行</view>
    </view>
  </view>

  <block wx:if="{{result}}">
    <view class="card">
      <view class="bazi-grid">
        <view class="bazi-col"><view class="bc-t">年柱</view><view class="bc-g">{{result.yg}}</view></view>
        <view class="bazi-col"><view class="bc-t">月柱</view><view class="bc-g">{{result.mg}}</view></view>
        <view class="bazi-col"><view class="bc-t">日柱</view><view class="bc-g">{{result.dg}}</view></view>
        <view class="bazi-col"><view class="bc-t">时柱</view><view class="bc-g">{{result.hg}}</view></view>
      </view>
      <view class="wx-row">
        <text class="w" wx:for="{{result.wx}}" wx:key="k">{{item.k}} {{item.v}}</text>
      </view>
      <view class="z-desc">{{result.line}}</view>
    </view>
  </block>

  <view class="disclaimer">八字内容由简化规则生成，为传统文化娱乐参考，非真实历法推算，不预示吉凶、不构成专业建议。</view>
</view>
<heart-lamp />
