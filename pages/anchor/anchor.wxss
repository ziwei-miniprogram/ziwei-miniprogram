/* pages/anchor/anchor.wxss —— 数字锚点（令牌驱动，双主题） */
.page {
  min-height: 100vh;
  background: var(--bg);
  padding: 8rpx 32rpx 60rpx;
  box-sizing: border-box;
}

/* —— 锚点诞生 / 定星 —— */
.hero {
  text-align: center;
  padding: 56rpx 8rpx 40rpx;
  background: transparent;
}
.star-mark {
  font-size: 40rpx;
  color: var(--gold);
  letter-spacing: 4rpx;
}
.kicker {
  margin-top: 14rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: var(--gold-deep);
  letter-spacing: 3rpx;
}
.page.dark .kicker { color: var(--gold); }
.anchor-name {
  margin-top: 16rpx;
  font-size: 52rpx;
  font-weight: 700;
  color: var(--fg);
  letter-spacing: 4rpx;
}
.wish {
  margin-top: 14rpx;
  font-size: 30rpx;
  color: var(--gold-deep);
  font-style: italic;
}
.page.dark .wish { color: var(--gold); }
.foot {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: var(--fg-2);
  line-height: 1.6;
}

/* —— 区块标题 —— */
.sec-t {
  margin: 48rpx 0 4rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: var(--gold-deep);
  letter-spacing: 3rpx;
}
.page.dark .sec-t { color: var(--gold); }

/* —— 沉星记录 —— */
.stars { display: flex; flex-direction: column; }
.star-item {
  display: flex;
  align-items: center;
  padding: 26rpx 4rpx;
  background: transparent;
  border-bottom: 1rpx solid var(--border);
}
.dot {
  width: 12rpx; height: 12rpx;
  border-radius: 50%;
  margin-right: 18rpx;
  background: var(--gold);
  flex: none;
}
.dot.lamp { background: var(--gold-deep); }
.dot.return { background: var(--success); }
.dot.deed { background: #b98e44; }
.sl { flex: 1; font-size: 26rpx; color: var(--fg); }
.sd { font-size: 22rpx; color: var(--fg-2); }
/* 空态改用全局 .empty-soft（✦ 标记 + 标题 + 说明） */

/* —— 归锚卡片 —— */
.return-card {
  margin-top: 56rpx;
  padding: 0;
  background: transparent;
  text-align: center;
}
.rc-t { font-size: 34rpx; font-weight: 700; color: var(--fg); letter-spacing: 1rpx; }
.rc-s { margin-top: 12rpx; font-size: 23rpx; color: var(--fg-2); line-height: 1.7; }

/* —— 按钮 —— */
.btn {
  margin-top: 28rpx;
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  border: 1rpx solid var(--gold);
  border-radius: 999rpx;
  background: transparent;
  color: var(--gold-deep);
  font-size: 29rpx;
  letter-spacing: 2rpx;
  font-weight: 600;
}
.page.dark .btn { color: var(--gold); }
.btn::after { border: none; }
.btn-done { background: transparent; border-color: var(--border); color: var(--fg-2); }
.page.dark .btn-done { color: var(--fg-2); }
.btn-lamp {
  margin-top: 20rpx;
  width: 100%;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  border: 1rpx solid var(--gold);
  border-radius: 999rpx;
  background: transparent;
  color: var(--gold-deep);
  font-size: 29rpx;
  letter-spacing: 2rpx;
  font-weight: 600;
}
.page.dark .btn-lamp { color: var(--gold); }
.btn-lamp::after { border: none; }
.btn-ghost {
  margin-top: 14rpx;
  width: 100%;
  height: 72rpx;
  line-height: 72rpx;
  border: none;
  background: transparent;
  color: var(--fg-2);
  font-size: 26rpx;
}
.btn-ghost::after { border: none; }

/* —— 长明灯灯火标记（CSS 绘制，无 emoji）—— */
.lamp-ic {
  width: 56rpx; height: 56rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 50% 42%, #ffe9b0 0%, #f3c969 38%, #c8a35a 72%, #8a6a2a 100%);
  box-shadow: 0 0 22rpx rgba(200,163,90,.55);
  animation: flicker 2.4s ease-in-out infinite;
  flex: none;
}
.lamp-ic.sm { width: 38rpx; height: 38rpx; box-shadow: 0 0 14rpx rgba(200,163,90,.45); }
.lamp-ic.lit { box-shadow: 0 0 38rpx rgba(217,182,106,.8); }
@keyframes flicker {
  0%, 100% { transform: scale(1); opacity: .92; }
  45% { transform: scale(1.06); opacity: 1; }
  70% { transform: scale(.97); opacity: .85; }
}

/* —— 已点亮的灯 —— */
.deeds { margin-top: 8rpx; }
.deed-card {
  padding: 26rpx 4rpx;
  background: transparent;
  border-bottom: 1rpx solid var(--border);
}
.dl { display: flex; align-items: center; gap: 12rpx; font-size: 26rpx; color: var(--fg); font-weight: 600; }
.dm { margin-top: 8rpx; font-size: 22rpx; color: var(--fg-2); }

/* —— 免责声明 —— */
.disclaimer {
  margin-top: 40rpx;
  font-size: 20rpx;
  color: var(--fg-2);
  line-height: 1.7;
  text-align: center;
}

/* —— 长明灯流程遮罩 —— */
.mask {
  position: fixed; inset: 0;
  background: rgba(11,20,38,.55);
  display: flex; align-items: flex-end;
  z-index: 50;
}
.sheet {
  width: 100%;
  background: var(--bg);
  border-radius: 36rpx 36rpx 0 0;
  padding: 40rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.lamp-vis { text-align: center; margin-bottom: 16rpx; }
.lamp-title { text-align: center; font-size: 32rpx; font-weight: 700; color: var(--fg); }
.lamp-sub { text-align: center; margin-top: 10rpx; font-size: 24rpx; color: var(--fg-2); line-height: 1.7; }
.deed-opt {
  display: flex; align-items: center; gap: 18rpx;
  margin-top: 20rpx;
  padding: 26rpx 24rpx;
  background: transparent;
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
}
.deed-opt.on { border-color: var(--gold); }
.do-body { flex: 1; }
.do-t { font-size: 28rpx; font-weight: 600; color: var(--fg); }
.do-s { margin-top: 6rpx; font-size: 22rpx; color: var(--fg-2); }
.price { font-size: 30rpx; font-weight: 700; color: var(--gold-deep); }
.page.dark .price { color: var(--gold); }
.lamp-note {
  margin-top: 26rpx;
  padding: 20rpx 0 0;
  font-size: 22rpx;
  color: var(--fg-2);
  line-height: 1.7;
  border-top: 1rpx solid var(--border);
}
.lamp-note .b { color: var(--gold-deep); font-weight: 600; }
.page.dark .lamp-note .b { color: var(--gold); }
.pay-amt {
  text-align: center;
  margin: 28rpx 0;
  font-size: 56rpx;
  font-weight: 800;
  color: var(--gold-deep);
}
.page.dark .pay-amt { color: var(--gold); }
.gift {
  text-align: center;
  margin: 18rpx 0 6rpx;
  font-size: 24rpx;
  color: var(--success);
}

/* —— 回音时间线 —— */
.timeline { margin-top: 18rpx; display: flex; flex-direction: column; }
.tl { display: flex; gap: 18rpx; padding: 14rpx 0; }
.tl-dot {
  width: 18rpx; height: 18rpx;
  border-radius: 50%;
  margin-top: 8rpx;
  background: var(--border);
  flex: none;
}
.tl.on .tl-dot { background: var(--gold); box-shadow: 0 0 12rpx rgba(200,163,90,.6); }
.tl-body { flex: 1; }
.tl-t { font-size: 26rpx; font-weight: 600; color: var(--fg); }
.tl-d { margin-top: 4rpx; font-size: 22rpx; color: var(--fg-2); line-height: 1.6; }
.tl:not(.on) .tl-t { color: var(--fg-2); }
