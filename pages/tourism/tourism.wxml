<import src="/utils/whimsy.wxml"/>
<view class="page {{theme}} container">
  <view class="head">
    <view class="h-t">星象文旅</view>
    <view class="h-s">把星图里的「迁移宫 / 福德宫」<br>变成真实的山水旅程</view>
  </view>

  <!-- 城市守护 · 星图点亮（文旅打卡 P0）-->
  <view class="city-guard">
    <view class="cg-head">
      <view class="cg-t">城市守护 · 星图点亮</view>
      <view class="cg-s">到访一座城，点亮一颗星</view>
    </view>

    <!-- P1 GPS 自动打卡：地图 + 附近检测 -->
    <view class="cg-map-wrap">
      <map class="cg-map" latitude="{{mapLat}}" longitude="{{mapLng}}" scale="4" markers="{{markers}}" show-location></map>
      <view class="cg-detect" bindtap="detectNearby">检测附近城市（自动点亮）</view>
      <view class="cg-map-tip">授权定位后，到访城市星图将自动点亮</view>
      <view class="cg-remote" bindtap="remoteCheckInCity"><astro name="lamp" size="28" theme="{{theme}}"/> 遥寄祝福（不在当地也能守护）</view>
    </view>

    <!-- 城市星图：已点亮高亮（虚高起点由进度条体现）-->
    <view class="cg-cities">
      <view class="cg-city {{checkedMap[item.id] ? 'on' : ''}}" wx:for="{{cities}}" wx:key="id">
        <astro class="cg-star" name="{{item.star}}" size="40" theme="{{theme}}"/>
        <text class="cg-name">{{item.name}}</text>
        <view class="cg-done" wx:if="{{checkedMap[item.id]}}">{{remoteMap[item.id] ? '遥寄点亮' : '已点亮'}}</view>
      </view>
    </view>

    <!-- 目标梯度进度条 + 文案 -->
    <view class="cg-bar"><view class="cg-fill" style="width:{{progressPct}}%"></view></view>
    <view class="cg-tip" wx:if="{{checkedCount === 0}}">点亮第 1 城，开启你的星图守护</view>
    <view class="cg-tip" wx:else>已点亮 {{checkedCount}} / {{total}} 城 · 差 {{remain}} 城解锁限定礼</view>

    <!-- P2：全国守护礼（集满 6 城解锁）-->
    <view class="cg-nation {{allReward.done ? 'on' : ''}}">
      <astro class="cn-emoji" name="{{allReward.done ? 'award' : 'star'}}" size="40" theme="{{theme}}"/>
      <view class="cn-body">
        <view class="cn-t">{{allReward.rewardName}}</view>
        <view class="cn-d">{{allReward.rewardDesc}}</view>
      </view>
    </view>

    <!-- 到访打卡：每城一个点亮按钮 -->
    <view class="cg-actions">
      <view class="cg-btn" wx:for="{{cities}}" wx:key="id"
        data-city="{{item.id}}" bindtap="checkInCity">
        {{checkedMap[item.id] ? '✓ ' + item.name : '点亮' + item.name}}
      </view>
    </view>

    <!-- 默认偏置解锁的奖励提示 -->
    <view class="cg-reward" wx:if="{{hasReward}}">已解锁城市守护折扣 + 限定优先购资格（24h）</view>
  </view>

  <!-- 峰值 ContextualCta（UX 架构 P0-d，解 B5）：点亮城市后顺手结缘 -->
  <contextual-reco icon="tourism" tag="点亮城市后 · 顺手结缘" name="城市守护 · 星空冰箱贴" desc="把点亮的城市星图，贴在冰箱上日日相伴" url="/pages/mall/mall" cta="去结缘" />

  <!-- P2：城市守护榜（本地社会证明，从众驱动复访打卡）-->
  <view class="guard-board">
    <view class="gb-head">
      <view class="gb-t">城市守护榜</view>
      <view class="gb-s">点亮一座城，汇入星野守护</view>
    </view>
    <view class="gb-self">
      <astro class="gb-self-emoji" name="star" size="30" theme="{{theme}}"/>
      <text class="gb-self-t">你已点亮 <text class="gb-self-n">{{guardSelf}}</text> / {{total}} 城</text>
      <text class="gb-self-tail" wx:if="{{guardAllDone}}">· 全国守护礼已解锁</text>
      <text class="gb-self-tail" wx:else>· 还差 {{allReward.remain}} 城</text>
    </view>
    <view class="gb-others">已有 <text class="gb-others-n">{{guardOthers}}</text> 位星友点亮过这些城</view>
    <view class="gb-foot">每点亮一座城，都是对这片山水的一次温柔守诺</view>
  </view>

  <view class="filters">
    <view class="chip {{filter===item?'on':''}}" wx:for="{{filters}}" wx:key="*this"
      data-f="{{item}}" bindtap="onFilter">{{item}}</view>
  </view>

  <!-- 本期精选 -->
  <view class="feature">
    <view class="badge">本期精选</view>
    <view class="ft">{{feature.title}}</view>
    <view class="fd">{{feature.desc}}</view>
    <view class="fm">
      <text class="tag">{{feature.tag}}</text>
      <text class="tag">大暑前后</text>
    </view>
    <view class="fp"><view class="p">¥{{feature.price}}</view><view class="d">/人 · {{feature.days}} 天</view></view>
  </view>

  <!-- 线路列表 -->
  <view class="list">
    <view class="card" wx:for="{{tours}}" wx:key="id">
      <view class="cov {{item.g}}"><astro name="{{item.cover}}" size="64" theme="{{theme}}"/></view>
      <view class="info">
        <view class="tt">{{item.title}}</view>
        <view class="ds">{{item.desc}}</view>
        <text class="tg">{{item.tag}}</text>
        <view class="meta"><text class="price">¥{{item.price}}</text> · {{item.days}} 天</view>
      </view>
      <view class="book" data-index="{{index}}" bindtap="book">预订</view>
    </view>
  </view>
</view>
<template is="whimsyFx"/>
<view class="disclaimer">温馨提示：本平台星象、抽签、卡牌等内容均为传统文化与心理慰藉的娱乐参考，不预示吉凶、不构成任何专业建议，请勿迷信。如遇情绪困扰，请寻求专业帮助。</view>
