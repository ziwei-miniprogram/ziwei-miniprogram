/* 星象文旅 —— 浅色简洁（暖纸 + 星辉金），深蓝星夜仅作封面点缀 */
.container { padding: 0 0 110rpx; }
.head { padding: 32rpx 32rpx 8rpx; }
.h-t { font-family: "Source Han Serif SC", "Songti SC", serif; font-size: 46rpx; font-weight: 700; color: var(--fg); }
.h-s { font-size: 24rpx; color: var(--fg-2); margin-top: 12rpx; line-height: 1.6; }

/* 筛选 */
.filters { display: flex; gap: 16rpx; padding: 24rpx 32rpx 8rpx; flex-wrap: wrap; }
.chip { padding: 16rpx 30rpx; border-radius: 999rpx; font-size: 24rpx;
  border: 1rpx solid var(--border); background: var(--card); color: var(--fg-2); }
.chip.on { background: linear-gradient(135deg, #e0c489, #c8a35a); color: #fff; font-weight: 700; border: none; }

/* 本期精选 */
.feature { margin: 28rpx 28rpx 0; border-radius: 40rpx; padding: 40rpx; position: relative; overflow: hidden;
  background: linear-gradient(135deg, #fff7e9, #fdeccb); border: 1rpx solid var(--border); }
.page.dark .feature { background: linear-gradient(135deg, #1b2740, #142033); border-color: var(--border); }
.badge { display: inline-block; font-size: 22rpx; color: #fff; background: #c8a35a;
  padding: 8rpx 22rpx; border-radius: 999rpx; font-weight: 700; }
.ft { font-family: "Source Han Serif SC", serif; font-size: 40rpx; color: var(--fg); margin-top: 24rpx; font-weight: 700; }
.fd { font-size: 24rpx; color: var(--fg-2); margin-top: 14rpx; line-height: 1.6; }
.fm { display: flex; gap: 14rpx; margin-top: 24rpx; }
.fm .tag { font-size: 22rpx; color: #b8945a; background: rgba(200, 163, 90, .14); padding: 8rpx 22rpx; border-radius: 999rpx; }
.fp { position: absolute; right: 36rpx; bottom: 32rpx; text-align: right; }
.fp .p { font-size: 40rpx; font-weight: 700; color: #c8a35a; }
.fp .d { font-size: 22rpx; color: #998f80; }

/* 列表 */
.list { padding: 8rpx 28rpx 0; }
.card { background: var(--card); border: 1rpx solid var(--border); border-radius: 32rpx;
  padding: 28rpx; margin-top: 24rpx; display: flex; align-items: center;
  box-shadow: var(--shadow-sm); }
.cov { width: 140rpx; height: 140rpx; border-radius: 28rpx; display: flex; align-items: center; justify-content: center;
  font-size: 64rpx; flex-shrink: 0; margin-right: 24rpx; background: linear-gradient(135deg, #0B1426, #16243f); }
.cov.a { background: linear-gradient(135deg, #1f4a3e, #123026); }
.cov.b { background: linear-gradient(135deg, #2a3f63, #16243f); }
.cov.c { background: linear-gradient(135deg, #4a3f2f, #2a2418); }
.info { flex: 1; min-width: 0; }
.tt { font-size: 30rpx; font-weight: 700; color: var(--fg); }
.ds { font-size: 22rpx; color: var(--fg-2); margin: 8rpx 0 12rpx; line-height: 1.5;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.tg { font-size: 22rpx; color: #5e9788; background: rgba(127, 183, 168, .14); padding: 6rpx 18rpx; border-radius: 999rpx; }
.meta { font-size: 24rpx; color: var(--fg-2); margin-top: 14rpx; }
.meta .price { color: var(--gold); font-size: 30rpx; font-weight: 700; }
.book { flex-shrink: 0; margin-left: 20rpx; background: transparent; color: var(--gold);
  border: 1rpx solid rgba(200, 163, 90, .5); border-radius: 999rpx; padding: 18rpx 28rpx; font-size: 26rpx; }
.book:active { background: rgba(200, 163, 90, .1); }

/* ===== 文旅打卡 P0：城市守护 · 星图点亮（令牌驱动，明暗自适应）===== */
.city-guard { margin: 24rpx 28rpx 0; border-radius: 32rpx; padding: 32rpx;
  background: var(--card); border: 1rpx solid var(--border); box-shadow: var(--shadow-sm); }
.cg-head { display: flex; align-items: baseline; gap: 16rpx; }
.cg-t { font-family: "Source Han Serif SC", "Songti SC", serif; font-size: 32rpx; font-weight: 700; color: var(--fg); }
.cg-s { font-size: 22rpx; color: var(--fg-2); }
.cg-cities { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 22rpx; }
.cg-city { position: relative; width: calc((100% - 42rpx) / 4); box-sizing: border-box;
  background: var(--bg-elev); border: 1rpx solid var(--border); border-radius: 18rpx; padding: 18rpx 0; text-align: center; }
.cg-city.on { border-color: var(--gold); background: var(--gold-soft); }
.cg-star { font-size: 40rpx; display: block; }
.cg-name { font-size: 22rpx; color: var(--fg-3); margin-top: 6rpx; display: block; }
.cg-city.on .cg-name { color: var(--gold-deep); font-weight: 700; }
.cg-done { position: absolute; top: -10rpx; right: -6rpx; font-size: 18rpx; color: #fff;
  background: var(--gold); border-radius: 999rpx; padding: 2rpx 12rpx; }
.cg-bar { height: 14rpx; background: rgba(138, 127, 109, .22); border-radius: 10rpx; overflow: hidden; margin-top: 24rpx; }
.cg-fill { height: 100%; background: linear-gradient(90deg, var(--gold), var(--gold-deep)); border-radius: 10rpx;
  transition: width .8s cubic-bezier(.2, .8, .2, 1); }
.cg-tip { font-size: 22rpx; color: var(--fg-2); margin-top: 14rpx; }
.cg-actions { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 18rpx; }
.cg-btn { flex: 1 1 calc((100% - 28rpx) / 3); text-align: center; padding: 18rpx 0; border-radius: 999rpx;
  font-size: 24rpx; background: linear-gradient(135deg, var(--gold), #e0c489); color: #3a2c10; font-weight: 600; }
.cg-btn:active { filter: brightness(.96); }
.cg-reward { margin-top: 18rpx; font-size: 22rpx; color: var(--gold-deep); background: var(--gold-soft);
  border: 1rpx solid rgba(200, 163, 90, .22); border-radius: 14rpx; padding: 14rpx 20rpx; }
.page.dark .city-guard { box-shadow: var(--shadow-md); }

/* 尊重系统「减少动态效果」偏好 */
@media (prefers-reduced-motion: reduce) {
  .cg-fill { transition: none; }
}
