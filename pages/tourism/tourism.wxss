/* 星象文旅 —— 浅色简洁（暖纸 + 星辉金），深蓝星夜仅作封面点缀 */
.container { padding: 0 0 110rpx; }
.head { padding: 32rpx 32rpx 8rpx; }
.h-t { font-family: "Source Han Serif SC", "Songti SC", serif; font-size: 46rpx; font-weight: 700; color: var(--fg); }
.h-s { font-size: 24rpx; color: var(--fg-2); margin-top: 12rpx; line-height: 1.6; }

/* 筛选 */
.filters { display: flex; gap: 16rpx; padding: 24rpx 32rpx 8rpx; flex-wrap: wrap; }
.chip { padding: 16rpx 30rpx; border-radius: 999rpx; font-size: 24rpx;
  border: 1rpx solid var(--border); background: var(--card); color: var(--fg-2); }
.chip.on { background: linear-gradient(135deg, #e0c489, #c8a35a); color: #fff; font-weight: 700; border: none; }

/* 本期精选 */
.feature { margin: 28rpx 28rpx 0; border-radius: 40rpx; padding: 40rpx; position: relative; overflow: hidden;
  background: linear-gradient(135deg, #fff7e9, #fdeccb); border: 1rpx solid var(--border); }
.page.dark .feature { background: linear-gradient(135deg, #1b2740, #142033); border-color: var(--border); }
.badge { display: inline-block; font-size: 22rpx; color: #fff; background: #c8a35a;
  padding: 8rpx 22rpx; border-radius: 999rpx; font-weight: 700; }
.ft { font-family: "Source Han Serif SC", serif; font-size: 40rpx; color: var(--fg); margin-top: 24rpx; font-weight: 700; }
.fd { font-size: 24rpx; color: var(--fg-2); margin-top: 14rpx; line-height: 1.6; }
.fm { display: flex; gap: 14rpx; margin-top: 24rpx; }
.fm .tag { font-size: 22rpx; color: #b8945a; background: rgba(200, 163, 90, .14); padding: 8rpx 22rpx; border-radius: 999rpx; }
.fp { position: absolute; right: 36rpx; bottom: 32rpx; text-align: right; }
.fp .p { font-size: 40rpx; font-weight: 700; color: #c8a35a; }
.fp .d { font-size: 22rpx; color: #998f80; }

/* 列表 */
.list { padding: 8rpx 28rpx 0; }
.card { background: var(--card); border: 1rpx solid var(--border); border-radius: 32rpx;
  padding: 28rpx; margin-top: 24rpx; display: flex; align-items: center;
  box-shadow: var(--shadow-sm); }
.cov { width: 140rpx; height: 140rpx; border-radius: 28rpx; display: flex; align-items: center; justify-content: center;
  font-size: 64rpx; flex-shrink: 0; margin-right: 24rpx; background: linear-gradient(135deg, #0B1426, #16243f); }
.cov.a { background: linear-gradient(135deg, #1f4a3e, #123026); }
.cov.b { background: linear-gradient(135deg, #2a3f63, #16243f); }
.cov.c { background: linear-gradient(135deg, #4a3f2f, #2a2418); }
.info { flex: 1; min-width: 0; }
.tt { font-size: 30rpx; font-weight: 700; color: var(--fg); }
.ds { font-size: 22rpx; color: var(--fg-2); margin: 8rpx 0 12rpx; line-height: 1.5;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.tg { font-size: 22rpx; color: #5e9788; background: rgba(127, 183, 168, .14); padding: 6rpx 18rpx; border-radius: 999rpx; }
.meta { font-size: 24rpx; color: var(--fg-2); margin-top: 14rpx; }
.meta .price { color: var(--gold); font-size: 30rpx; font-weight: 700; }
.book { flex-shrink: 0; margin-left: 20rpx; background: transparent; color: var(--gold);
  border: 1rpx solid rgba(200, 163, 90, .5); border-radius: 999rpx; padding: 18rpx 28rpx; font-size: 26rpx; }
.book:active { background: rgba(200, 163, 90, .1); }

/* ===== 文旅打卡 P0：城市守护 · 星图点亮（令牌驱动，明暗自适应）===== */
.city-guard { margin: 24rpx 28rpx 0; border-radius: 32rpx; padding: 32rpx;
  background: var(--card); border: 1rpx solid var(--border); box-shadow: var(--shadow-sm); }
.cg-head { display: flex; align-items: baseline; gap: 16rpx; }
.cg-t { font-family: "Source Han Serif SC", "Songti SC", serif; font-size: 32rpx; font-weight: 700; color: var(--fg); }
.cg-s { font-size: 22rpx; color: var(--fg-2); }
.cg-cities { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 22rpx; }
.cg-city { position: relative; width: calc((100% - 42rpx) / 4); box-sizing: border-box;
  background: var(--bg-elev); border: 1rpx solid var(--border); border-radius: 18rpx; padding: 18rpx 0; text-align: center; }
.cg-city.on { border-color: var(--gold); background: var(--gold-soft); }
.cg-star { font-size: 40rpx; display: block; }
.cg-name { font-size: 22rpx; color: var(--fg-3); margin-top: 6rpx; display: block; }
.cg-city.on .cg-name { color: var(--gold-deep); font-weight: 700; }
.cg-done { position: absolute; top: -10rpx; right: -6rpx; font-size: 18rpx; color: #fff;
  background: var(--gold); border-radius: 999rpx; padding: 2rpx 12rpx; }
.cg-bar { height: 14rpx; background: rgba(138, 127, 109, .22); border-radius: 10rpx; overflow: hidden; margin-top: 24rpx; }
.cg-fill { height: 100%; background: linear-gradient(90deg, var(--gold), var(--gold-deep)); border-radius: 10rpx;
  transition: width .8s cubic-bezier(.2, .8, .2, 1); }
.cg-tip { font-size: 22rpx; color: var(--fg-2); margin-top: 14rpx; }
.cg-actions { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 18rpx; }
.cg-btn { flex: 1 1 calc((100% - 28rpx) / 3); text-align: center; padding: 18rpx 0; border-radius: 999rpx;
  font-size: 24rpx; background: linear-gradient(135deg, var(--gold), #e0c489); color: #3a2c10; font-weight: 600; }
.cg-btn:active { filter: brightness(.96); }
.cg-reward { margin-top: 18rpx; font-size: 22rpx; color: var(--gold-deep); background: var(--gold-soft);
  border: 1rpx solid rgba(200, 163, 90, .22); border-radius: 14rpx; padding: 14rpx 20rpx; }
.page.dark .city-guard { box-shadow: var(--shadow-md); }

/* ===== P2：全国守护礼（集满 6 城解锁）===== */
.cg-nation { display: flex; align-items: center; gap: 18rpx; margin-top: 18rpx;
  background: var(--bg-elev); border: 1rpx solid var(--border); border-radius: 16rpx; padding: 18rpx 20rpx; }
.cg-nation.on { background: var(--gold-soft); border-color: rgba(200, 163, 90, .38); }
.cn-emoji { font-size: 40rpx; }
.cn-body { flex: 1; min-width: 0; }
.cn-t { font-size: 26rpx; font-weight: 700; color: var(--fg); }
.cg-nation.on .cn-t { color: var(--gold-deep); }
.cn-d { font-size: 22rpx; color: var(--fg-2); margin-top: 6rpx; line-height: 1.5; }

/* ===== P2：城市守护榜（本地社会证明）===== */
.guard-board { margin: 24rpx 28rpx 0; border-radius: 32rpx; padding: 32rpx;
  background: var(--card); border: 1rpx solid var(--border); box-shadow: var(--shadow-sm); }
.gb-head { display: flex; align-items: baseline; gap: 16rpx; }
.gb-t { font-family: "Source Han Serif SC", "Songti SC", serif; font-size: 32rpx; font-weight: 700; color: var(--fg); }
.gb-s { font-size: 22rpx; color: var(--fg-2); }
.gb-self { display: flex; align-items: center; gap: 10rpx; margin-top: 22rpx; font-size: 26rpx; color: var(--fg-3); }
.gb-self-emoji { font-size: 34rpx; }
.gb-self-n { font-size: 32rpx; font-weight: 700; color: var(--gold-deep); }
.gb-self-tail { color: var(--fg-2); font-size: 24rpx; }
.gb-others { margin-top: 14rpx; font-size: 24rpx; color: var(--fg-2); }
.gb-others-n { font-weight: 700; color: var(--gold-deep); }
.gb-foot { margin-top: 16rpx; font-size: 22rpx; color: var(--fg-2); line-height: 1.6;
  border-top: 1rpx solid var(--border); padding-top: 16rpx; }

/* ===== P1：GPS 自动打卡地图（令牌驱动，明暗自适应）===== */
.cg-map-wrap { margin-top: 18rpx; }
.cg-map { width: 100%; height: 280rpx; border-radius: 18rpx; border: 1rpx solid var(--border); }
.cg-detect { margin-top: 14rpx; text-align: center; padding: 18rpx 0; border-radius: 999rpx;
  font-size: 24rpx; background: linear-gradient(135deg, var(--gold), #e0c489); color: #3a2c10; font-weight: 600; }
.cg-detect:active { filter: brightness(.96); }
.cg-map-tip { font-size: 20rpx; color: var(--fg-2); margin-top: 10rpx; text-align: center; }
/* P0-c 遥寄祝福：与 detect 并排的温柔入口（解 B6 GPS 硬门槛） */
.cg-remote { margin-top: 12rpx; text-align: center; padding: 18rpx 0; border-radius: 999rpx;
  font-size: 24rpx; background: var(--gold-soft); color: var(--gold-deep); font-weight: 600;
  border: 1rpx solid rgba(200,163,90,.4); }
.cg-remote:active { background: var(--gold-tint); }

/* 尊重系统「减少动态效果」偏好 */
@media (prefers-reduced-motion: reduce) {
  .cg-fill { transition: none; }
  .fr-fill { transition: none; }
}

/* ===== 福建官方线路 · 星图巡礼（静态线路模板，令牌驱动，明暗自适应）===== */
.fr { margin: 24rpx 28rpx 0; border-radius: 32rpx; padding: 32rpx;
  background: var(--card); border: 1rpx solid var(--border); box-shadow: var(--shadow-sm); }
.fr-head { display: flex; align-items: baseline; gap: 16rpx; flex-wrap: wrap; }
.fr-t { font-family: "Source Han Serif SC", "Songti SC", serif; font-size: 32rpx; font-weight: 700; color: var(--fg); }
.fr-s { font-size: 22rpx; color: var(--fg-2); line-height: 1.5; }

.fr-sum { display: flex; align-items: baseline; gap: 8rpx; margin-top: 20rpx; }
.fr-sum-n { font-size: 40rpx; font-weight: 700; color: var(--gold-deep); }
.fr-sum-t { font-size: 22rpx; color: var(--fg-2); }

/* 目标梯度：推荐卡（不做虚高起点，改为直接给下一站）*/
.fr-reco { display: flex; align-items: center; gap: 16rpx; margin-top: 18rpx;
  background: var(--gold-soft); border: 1rpx solid rgba(200, 163, 90, .35);
  border-radius: 18rpx; padding: 20rpx; }
.fr-reco.all { background: var(--bg-elev); border-color: var(--border); }
.fr-reco-b { flex: 1; min-width: 0; }
.fr-reco-t { font-size: 26rpx; font-weight: 700; color: var(--gold-deep); }
.fr-reco.all .fr-reco-t { color: var(--fg); }
.fr-reco-d { font-size: 22rpx; color: var(--fg-2); margin-top: 6rpx; }
.fr-reco-go { flex-shrink: 0; padding: 14rpx 30rpx; border-radius: 999rpx; font-size: 24rpx; font-weight: 600;
  background: linear-gradient(135deg, var(--gold), #e0c489); color: #3a2c10; }
.fr-reco-go:active { filter: brightness(.96); }

/* 线路卡 */
.fr-card { margin-top: 22rpx; background: var(--bg-elev); border: 1rpx solid var(--border);
  border-radius: 22rpx; padding: 24rpx; }
.fr-card.on { border-color: rgba(200, 163, 90, .45); background: var(--gold-soft); }
.fr-c-head { display: flex; align-items: center; gap: 14rpx; }
.fr-c-b { flex: 1; min-width: 0; }
.fr-c-t { font-size: 28rpx; font-weight: 700; color: var(--fg); }
.fr-c-band { font-size: 20rpx; color: var(--fg-3); margin-top: 4rpx; }
.fr-c-n { flex-shrink: 0; font-size: 26rpx; font-weight: 700; color: var(--gold-deep); }
.fr-c-desc { font-size: 22rpx; color: var(--fg-2); margin-top: 14rpx; line-height: 1.6; }

.fr-bar { height: 12rpx; background: rgba(138, 127, 109, .2); border-radius: 10rpx; overflow: hidden; margin-top: 18rpx; }
.fr-fill { height: 100%; background: linear-gradient(90deg, var(--gold), var(--gold-deep)); border-radius: 10rpx;
  transition: width .7s cubic-bezier(.2, .8, .2, 1); }

.fr-spots { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 18rpx; }
.fr-spot { box-sizing: border-box; width: calc((100% - 12rpx) / 2); display: flex; align-items: center; gap: 10rpx;
  padding: 14rpx 16rpx; border-radius: 14rpx; background: var(--card);
  border: 1rpx solid var(--border); color: var(--fg-2); }
.fr-spot.on { border-color: var(--gold); background: var(--gold-soft); }
.fr-spot-n { flex: 1; min-width: 0; font-size: 22rpx;
  overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.fr-spot.on .fr-spot-n { color: var(--gold-deep); font-weight: 600; }

.fr-c-foot { margin-top: 16rpx; font-size: 22rpx; line-height: 1.5; }
.fr-shard { color: var(--gold-deep); font-weight: 600; }
.fr-next { color: var(--fg-2); }

.fr-tip { margin-top: 20rpx; font-size: 20rpx; color: var(--fg-3); line-height: 1.6;
  border-top: 1rpx solid var(--border); padding-top: 16rpx; }

.page.dark .fr { box-shadow: var(--shadow-md); }

/* ===== 非遗星图容器（碎片来自「走到 · 做善 · 答题」）===== */
.hmw { margin: 24rpx 28rpx 0; }
.hmw-head { display: flex; align-items: baseline; gap: 14rpx; flex-wrap: wrap; }
.hmw-t { font-family: "Source Han Serif SC", "Songti SC", serif; font-size: 32rpx; font-weight: 700; color: var(--fg); }
.hmw-s { font-size: 22rpx; color: var(--fg-2); font-variant-numeric: tabular-nums; }
.hmw-note { font-size: 22rpx; color: var(--fg-2); margin-top: 10rpx; line-height: 1.6; }
.hmw-note.done { color: var(--gold-deep); font-weight: 600; }
.hmw-tip { font-size: 20rpx; color: var(--fg-3); line-height: 1.6; margin-top: 4rpx;
  border-top: 1rpx solid var(--border); padding-top: 14rpx; }
