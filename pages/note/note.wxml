<view class="page {{theme}}">
<view class="nb" wx:if="{{note}}">
  <view class="nb-hero" style="background:{{note.bg}}">{{note.emoji}}
    <view class="dots"><view class="d on"></view><view class="d"></view><view class="d"></view></view>
  </view>

  <view class="nb-body">
    <view class="topic">#{{note.topic}}</view>
    <view class="h2">{{note.title}}</view>
    <view class="txt">{{note.body}}</view>

    <view class="author">
      <view class="av">{{note.author.avatar}}</view>
      <view class="nm">{{note.author.name}}</view>
      <view class="follow">关注</view>
    </view>

    <view class="rel" wx:if="{{related.length}}">
      <view class="rel-h">相关星野笔记</view>
      <view class="rel-grid">
        <view class="rel-card" wx:for="{{related}}" wx:key="id" data-id="{{item.id}}" bindtap="openNote">
          <view class="rel-img" style="background:{{item.bg}}">{{item.emoji}}</view>
          <view class="rel-tt">{{item.title}}</view>
        </view>
      </view>
    </view>
    <view class="cmt-list" wx:if="{{comments.length}}">
      <view class="cmt-list-h">足迹 · {{comments.length}}</view>
      <view class="cmt-item" wx:for="{{comments}}" wx:key="id">
        <view class="cmt-av">我</view>
        <view class="cmt-body">
          <view class="cmt-name">我 · {{item.t}}</view>
          <view class="cmt-text">{{item.text}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="nb-bar">
    <view class="cmt" bindtap="openComment">说点什么…</view>
    <view class="act {{liked?'on':''}}" bindtap="toggleLike">♥ {{likeNum}}</view>
    <view class="act {{collected?'on':''}}" bindtap="toggleCollect">⭐ {{collectNum}}</view>
    <view class="act" bindtap="addLamp">🪔 +1</view>
  </view>
  <view class="cmt-panel" wx:if="{{showComment}}">
    <textarea class="cmt-input" placeholder="温柔地留一句话…" value="{{commentText}}" bindinput="onComment" maxlength="120" focus="{{showComment}}" />
    <view class="cmt-actions">
      <view class="cmt-cancel" bindtap="closeComment">取消</view>
      <view class="cmt-send" bindtap="sendComment">发送</view>
    </view>
  </view>
</view>
<view class="disclaimer" wx:if="{{note}}">本平台星象、抽签、卡牌等内容均为传统文化与心理慰藉的娱乐参考，不预示吉凶、不构成任何专业建议，请勿迷信。</view>
</view>
