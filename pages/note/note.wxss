.nb { padding-bottom: 120rpx; }
.nb-hero { height: 620rpx; display: flex; align-items: center; justify-content: center; font-size: 120rpx; color: #fff; position: relative; }
.nb-hero .dots { position: absolute; bottom: 24rpx; left: 50%; transform: translateX(-50%); display: flex; gap: 10rpx; }
.nb-hero .dots .d { width: 12rpx; height: 12rpx; border-radius: 50%; background: rgba(255,255,255,.5); }
.nb-hero .dots .d.on { background: #fff; width: 28rpx; border-radius: 8rpx; }

.nb-body { padding: 30rpx 30rpx 0; }
.topic { display: inline-block; font-size: 22rpx; color: var(--gold-deep); background: var(--gold-tint); border-radius: 8rpx; padding: 4rpx 14rpx; }
.h2 { font-size: 38rpx; font-weight: 700; line-height: 1.4; margin-top: 16rpx; color: var(--fg); }
.txt { font-size: 29rpx; line-height: 1.9; color: var(--fg); margin-top: 22rpx; }

.author { display: flex; align-items: center; gap: 18rpx; margin: 34rpx 0; padding: 22rpx; background: var(--bg-elev); border-radius: 24rpx; }
.author .av { width: 76rpx; height: 76rpx; border-radius: 50%; background: linear-gradient(135deg, var(--gold), #e0c489); display: flex; align-items: center; justify-content: center; color: #fff; font-size: 30rpx; }
.author .nm { font-size: 28rpx; font-weight: 600; flex: 1; color: var(--fg); }
.author .follow { background: var(--gold); color: #fff; border-radius: 999rpx; padding: 12rpx 34rpx; font-size: 26rpx; }

.rel { margin-top: 10rpx; }
.rel-h { font-size: 26rpx; color: var(--fg-2); margin: 20rpx 0; }
.rel-grid { display: flex; gap: 14rpx; }
.rel-card { flex: 1; background: var(--card); border-radius: 18rpx; overflow: hidden; box-shadow: var(--shadow-sm); }
.rel-img { height: 150rpx; display: flex; align-items: center; justify-content: center; font-size: 50rpx; color: #fff; }
.rel-tt { font-size: 22rpx; line-height: 1.4; color: var(--fg); padding: 12rpx 14rpx 14rpx; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

.nb-bar { position: fixed; left: 0; right: 0; bottom: 0; height: 110rpx; background: var(--card); border-top: 1rpx solid var(--border); display: flex; align-items: center; gap: 24rpx; padding: 0 30rpx; z-index: 50; }
.nb-bar .cmt { flex: 1; background: var(--bg-elev); border-radius: 999rpx; height: 72rpx; display: flex; align-items: center; padding: 0 26rpx; color: var(--fg-2); font-size: 26rpx; }
.nb-bar .act { font-size: 26rpx; color: var(--fg-2); display: flex; align-items: center; gap: 6rpx; }
.nb-bar .act.on { color: var(--danger); font-weight: 600; }
