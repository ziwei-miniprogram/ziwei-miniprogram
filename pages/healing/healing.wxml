<view class="container page {{theme}}">
  <view class="card">
    <view class="title">精神疗愈空间</view>
    <view class="subtitle">情绪舒缓 · 非医疗行为 · 仅供放松参考</view>
  </view>

  <view class="card heal" wx:for="{{healings}}" wx:key="id" data-index="{{index}}" bindtap="play">
    <view class="heal-cover">{{item.cover}}</view>
    <view style="flex:1">
      <view class="title" style="font-size:30rpx">{{item.title}}</view>
      <view class="tag">{{item.type}}</view>
    </view>
    <view class="play">▶</view>
  </view>
</view>
<view class="disclaimer">温馨提示：本平台星象、抽签、卡牌等内容均为传统文化与心理慰藉的娱乐参考，不预示吉凶、不构成任何专业建议，请勿迷信。如遇情绪困扰，请寻求专业帮助。</view>
