.page { padding: 20rpx 24rpx 60rpx; }

.bar { padding: 8rpx 0 18rpx; }
.box {
  display: flex; align-items: center; gap: 14rpx;
  background: var(--card); border: 1rpx solid var(--border); border-radius: 999rpx;
  padding: 16rpx 26rpx;
}
.ic { font-size: 28rpx; }
.inp { flex: 1; font-size: 28rpx; color: var(--fg); }

.empty { text-align: center; padding: 90rpx 40rpx; }
.em { font-size: 64rpx; }
.em-tt { font-size: 28rpx; color: var(--fg); margin-top: 18rpx; }
.em-sub { font-size: 23rpx; color: var(--fg-2); margin-top: 8rpx; }

.list { display: flex; flex-direction: column; gap: 16rpx; }
.item {
  display: flex; align-items: center; gap: 22rpx;
  background: var(--card); border: 1rpx solid var(--border); border-radius: 20rpx;
  padding: 20rpx 24rpx;
}
.item:active { background: var(--bg-elev); }
.av {
  width: 84rpx; height: 84rpx; border-radius: 18rpx;
  display: flex; align-items: center; justify-content: center; font-size: 40rpx;
}
.info { flex: 1; min-width: 0; }
.tt {
  font-size: 28rpx; color: var(--fg); font-weight: 500;
  overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
}
.au { font-size: 22rpx; color: var(--fg-2); margin-top: 6rpx; }

.hint { text-align: center; color: var(--fg-2); font-size: 23rpx; padding: 80rpx 40rpx; }
