<view class="page {{theme}}">
  <view class="b-head">
    <view class="u-eyebrow">全部工具</view>
    <view class="u-h2">星野工具箱</view>
    <view class="u-lede">识星 · 安善 · 表达 —— 三簇归位，常用的三处直接在上面</view>
  </view>
  <view class="hair"></view>

  <!-- 高频常驻：Top3 动作 1 跳直达 -->
  <view class="pinned">
    <view class="pin" wx:for="{{pinned}}" wx:key="key" data-url="{{item.url}}" bindtap="go">
      <astro class="pic" name="{{item.icon}}" size="34" theme="{{theme}}"/>
      <view class="pnm">{{item.name}}</view>
      <view class="pds">{{item.desc}}</view>
    </view>
  </view>

  <!-- 分簇：识星 / 安善 / 表达，单列行式 -->
  <view class="cluster" wx:for="{{clusters}}" wx:for-item="c" wx:key="name">
    <view class="cl-h">{{c.name}}</view>
    <view class="hair-tight"></view>
    <view class="row" wx:for="{{c.items}}" wx:for-item="item" wx:key="key" data-url="{{item.url}}" bindtap="go">
      <astro class="ic" name="{{item.icon}}" size="30" theme="{{theme}}"/>
      <view class="rb">
        <view class="nm">{{item.name}}</view>
        <view class="ds">{{item.desc}}</view>
      </view>
      <view class="arrow">→</view>
    </view>
  </view>

  <view class="tip">所有功能均为传统文化与心理慰藉的娱乐参考，不预示吉凶、不构成专业建议。</view>
</view>
