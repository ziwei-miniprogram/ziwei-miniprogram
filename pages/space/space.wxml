<view class="page {{theme}}">
  <view class="hd">
    <view class="h-t">星野 · 工具箱</view>
    <view class="h-s">星图 · 疗愈 · 心灵 · 寄愿 · 祝福 · 功德</view>
  </view>

  <!-- 高频常驻：Top3 动作 1 跳直达（解 B2 深井） -->
  <view class="pinned">
    <view class="pin" wx:for="{{pinned}}" wx:key="key" data-url="{{item.url}}" bindtap="go">
      <image class="pic" src="{{item.icon}}" mode="aspectFit" />
      <view class="pnm">{{item.name}}</view>
      <view class="pds">{{item.desc}}</view>
    </view>
  </view>

  <!-- 分簇：识星 / 安善 / 表达 -->
  <view class="cluster" wx:for="{{clusters}}" wx:for-item="c" wx:key="name">
    <view class="cl-h">{{c.name}}</view>
    <view class="grid">
      <view class="cell" wx:for="{{c.items}}" wx:for-item="item" wx:key="key" data-url="{{item.url}}" bindtap="go">
        <image class="ic" src="{{item.icon}}" mode="aspectFit" />
        <view class="nm">{{item.name}}</view>
        <view class="ds">{{item.desc}}</view>
      </view>
    </view>
  </view>

  <view class="tip">所有功能均为传统文化与心理慰藉的娱乐参考，不预示吉凶、不构成专业建议。</view>
</view>
