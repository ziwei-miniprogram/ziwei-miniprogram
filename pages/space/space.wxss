.page { padding: 24rpx 24rpx 60rpx; }

.hd { padding: 16rpx 8rpx 28rpx; }
.h-t { font-size: 38rpx; font-weight: 700; color: var(--fg); }
.h-s { font-size: 24rpx; color: var(--fg-2); margin-top: 8rpx; }

.grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 22rpx;
}

.cell {
  background: var(--card);
  border: 1rpx solid var(--border);
  border-radius: 24rpx;
  padding: 34rpx 28rpx;
  box-shadow: var(--shadow-sm);
  transition: transform .15s ease;
}
.cell:active { transform: scale(0.97); }

.ic {
  width: 84rpx; height: 84rpx; border-radius: 22rpx;
  background: var(--bg-elev);
  display: flex; align-items: center; justify-content: center;
  font-size: 44rpx; margin-bottom: 20rpx;
}
.nm { font-size: 30rpx; font-weight: 600; color: var(--fg); }
.ds { font-size: 22rpx; color: var(--fg-2); margin-top: 6rpx; }

.tip {
  margin-top: 36rpx; font-size: 21rpx; color: var(--fg-2);
  line-height: 1.6; text-align: center;
}
