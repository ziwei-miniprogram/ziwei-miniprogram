.container { padding: 24rpx; }

/* 方向 B · 图标格：astro 需要显式尺寸盒子才能与文字基线对齐 */
.a-icon,
.de-ic,
.streak-flame,
.gr-emoji { display: flex; align-items: center; justify-content: center; flex: none; }
.d-head2,
.title { display: flex; align-items: center; gap: 10rpx; }
.d-flame { color: var(--gold); letter-spacing: 2rpx; }

.tabs {
  display: flex;
  gap: 40rpx;
  background: transparent;
  padding: 0;
  margin: 24rpx 0 8rpx;
  border-bottom: 1rpx solid var(--border);
}
.tab {
  position: relative;
  text-align: center;
  font-size: 28rpx;
  color: var(--fg-2);
  padding: 8rpx 0 16rpx;
}
.tab.on {
  color: var(--fg);
  font-weight: 700;
}
.tab.on::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
  width: 36rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: var(--gold);
}

.card {
  background: var(--card);
  border-radius: 20rpx;
  padding: 28rpx;
  margin: 20rpx 0;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--border);
}
.title { font-size: 34rpx; font-weight: 700; color: var(--gold-deep); }
.subtitle { font-size: 24rpx; color: var(--fg-2); margin-top: 6rpx; }

.hero-card { text-align: center; background: linear-gradient(160deg, var(--gold-soft), var(--gold-tint)); }
.merit-num { font-size: 80rpx; font-weight: 800; color: var(--gold-deep); line-height: 1; }
.merit-label { font-size: 24rpx; color: var(--fg-2); margin-top: 6rpx; }
.level-badge {
  display: inline-block;
  margin-top: 16rpx;
  background: var(--gold);
  color: #fff;
  font-size: 26rpx;
  padding: 6rpx 24rpx;
  border-radius: 999rpx;
}
.streak { font-size: 26rpx; color: var(--gold-deep); margin: 18rpx 0 8rpx; }

.progress {
  height: 16rpx;
  background: var(--bg-elev);
  border-radius: 999rpx;
  overflow: hidden;
  margin: 14rpx 0;
}
.progress-in {
  height: 100%;
  background: linear-gradient(90deg, var(--gold), #e0c489);
  border-radius: 999rpx;
}

.btn {
  background: linear-gradient(135deg, var(--gold), #e0c489);
  color: #fff;
  border-radius: 999rpx;
  text-align: center;
  padding: 22rpx;
  font-size: 30rpx;
  margin-top: 16rpx;
}
.btn-ghost {
  border: 2rpx solid var(--gold);
  color: var(--gold-deep);
  background: transparent;
}
.btn-done { background: var(--gold-soft); color: var(--gold-deep); }

.action {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--border);
}
.action:last-child { border-bottom: none; }
.a-icon { width: 40px; height: 40px; margin-right: 18rpx; }
.a-name { font-size: 28rpx; color: var(--fg); font-weight: 600; }
.a-desc { font-size: 22rpx; color: var(--fg-2); margin-top: 4rpx; }
.a-btn {
  background: var(--gold-soft);
  color: var(--gold-deep);
  font-size: 26rpx;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  font-weight: 700;
}
.a-done { background: var(--bg-elev); color: var(--fg-2); }

.chips { display: flex; gap: 16rpx; margin: 8rpx 0; }
.chip {
  font-size: 26rpx;
  color: var(--fg-2);
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  background: var(--card);
}
.chip.on { background: var(--gold); color: #fff; font-weight: 700; }

.board-head { font-size: 24rpx; color: var(--fg-2); padding-bottom: 12rpx; border-bottom: 1rpx solid var(--border); }
.board-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border);
}
.board-item.me { background: var(--gold-soft); border-radius: 12rpx; }
.b-rank { width: 48rpx; text-align: center; color: var(--gold-deep); font-weight: 700; }
.b-name { font-size: 28rpx; color: var(--fg); font-weight: 600; }
.b-region { font-size: 20rpx; color: var(--fg-2); }
.b-merit { width: 110rpx; text-align: right; color: var(--gold-deep); font-weight: 700; }
.b-level { width: 90rpx; text-align: right; font-size: 24rpx; color: var(--fg-2); }

.bond {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--border);
}
.bond:last-of-type { border-bottom: none; }

.lamp { color: var(--gold-deep); font-size: 28rpx; }
.wish-text { font-size: 28rpx; color: var(--fg); margin: 12rpx 0 16rpx; line-height: 1.6; }

/* 寄愿输入框即英雄（Act II 连接）：聚焦时背景星夜虚化 */
.wish-compose {
  position: relative; margin: 20rpx 24rpx 0; border-radius: 28rpx; overflow: hidden;
  padding: 28rpx 24rpx; border: 1rpx solid rgba(200,163,90,.3); background: var(--card);
}
.wc-bg {
  position: absolute; inset: 0; background: var(--night-grad); opacity: .06;
  transition: filter .4s ease, opacity .4s ease;
}
.wish-compose.focused .wc-bg { opacity: .16; filter: blur(8rpx); }
.wc-inner { position: relative; z-index: 2; }
.wc-eyebrow { font-size: 22rpx; color: var(--gold-deep); letter-spacing: 2rpx; margin-bottom: 12rpx; font-weight: 600; }
.wc-input {
  width: 100%; height: 120rpx; background: var(--bg-elev); color: var(--fg);
  border-radius: 16rpx; padding: 16rpx; font-size: 28rpx; box-sizing: border-box;
}
.wc-send {
  margin-top: 14rpx; text-align: center; padding: 16rpx; border-radius: 999rpx;
  background: var(--gold-soft); color: var(--gold-deep); font-size: 26rpx; font-weight: 700;
}
.wc-send.on { background: var(--gold-grad); color: #3a2c10; }
.muted { color: var(--fg-2); font-size: 22rpx; }

/* 因果日报 */
.daily { background: linear-gradient(160deg, var(--gold-soft), var(--gold-tint)); }
.d-head { font-size: 28rpx; font-weight: 700; color: var(--gold-deep); }
.d-text { font-size: 26rpx; color: var(--fg-3); line-height: 1.7; margin-top: 12rpx; }

/* 点亮城市 */
.cities { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 16rpx; }
.city { font-size: 24rpx; color: var(--gold-deep); background: var(--gold-soft); border-radius: 999rpx; padding: 8rpx 22rpx; }

/* 功德林头部 */
.board-head { display: flex; justify-content: space-between; align-items: center; }
.bh-king { color: var(--gold-deep); font-weight: 700; font-size: 26rpx; }
.bh-anon { font-size: 22rpx; color: var(--fg-2); background: var(--bg-elev); padding: 6rpx 18rpx; border-radius: 999rpx; }
.board-head2 { color: var(--fg-2); font-size: 22rpx; padding-top: 14rpx; }
.b-rank.king { font-size: 30rpx; color: var(--gold); }
