<view class="page {{theme}}">
  <view class="search"><astro name="search" size="26" theme="{{theme}}"/><text>搜索 星野好物</text></view>

  <!-- 文旅打卡 P0：城市守护折扣 + 限定优先购资格 -->
  <view class="coupon-strip" wx:if="{{couponCount > 0}}">已点亮 {{couponCount}} 座城市守护 · 全场兑换 9 折自动抵扣</view>
  <view class="priority-strip" wx:if="{{hasPriority}}">限定优先购生效中 · 剩 {{priorityText}}（到点失效）</view>

  <!-- P2：内容驱动推荐区（依星图/寄愿/三善/连签行为信号） -->
  <view class="reco-zone">
    <view class="reco-z-h">为你结缘 · 依你的星野足迹</view>
    <view class="mj-reco" wx:for="{{reco}}" wx:key="cat" data-cat="{{item.cat}}" bindtap="onRecoTap" hover-class="mj-reco-hover">
      <astro class="mj-reco-ic" name="{{item.icon}}" size="42" theme="{{theme}}"/>
      <view class="mj-reco-body">
        <view class="mj-reco-tag">{{item.tag}}</view>
        <view class="mj-reco-name">{{item.name}}</view>
        <view class="mj-reco-desc">{{item.desc}}</view>
      </view>
      <view class="mj-reco-go">去看看 ›</view>
    </view>
  </view>

  <!-- P2：功德 sink 多样 —— 用功德点亮虚拟长明祈福灯 -->
  <view class="merit-lamp" bindtap="lightLamp">
    <astro class="ml-ic" name="lamp" size="40" theme="{{theme}}"/>
    <view class="ml-body">
      <view class="ml-t">{{meritLampLit ? '长明祈福灯已点亮 · 可再点' : '用功德点亮长明祈福灯'}}</view>
      <view class="ml-s">当前 {{meritBalance}} 功德 · 点亮一盏虚拟结缘灯（纪念），- {{meritLampCost}} 功德</view>
    </view>
    <view class="ml-btn">点亮</view>
  </view>

  <!-- Apple 风商城头部：宽留白 + 大字号 -->
  <view class="mall-hero">
    <view class="u-eyebrow">结缘好物 · 依你而选</view>
    <view class="mall-h2">星野好物，陪你日行一善</view>
    <view class="mall-lede">香氛、手串、祈福御守——每一件都为静心与陪伴而做。</view>
  </view>

  <scroll-view class="cats" scroll-x>
    <view class="cat {{cat===item?'on':''}}" wx:for="{{cats}}" wx:key="*this" data-c="{{item}}" bindtap="switchCat">{{item}}</view>
  </scroll-view>

  <view class="feed">
      <view class="col">
        <view class="pd" wx:for="{{list}}" wx:key="id" wx:if="{{index % 2 === 0}}" data-index="{{index}}" bindtap="exchange">
          <view class="img" style="background:{{item.bg}}"><astro name="{{item.cover}}" size="72" theme="dark"/><view class="badge {{item.badgeCls}}" wx:if="{{item.badgeText}}">{{item.badgeText}}</view></view>
          <view class="body">
            <view class="tt">{{item.title}}</view>
            <view class="pr"><text class="price">{{item.cost}} 功德</text><text class="mtag" wx:if="{{item.meritTag}}">{{item.meritTag}}</text></view>
            <view class="sl">{{item.sales}}</view>
            <view class="buy">立即购买</view>
            <view class="share-btn {{item.shared ? 'done' : ''}}" wx:if="{{item.shareable}}" data-index="{{index}}" catchtap="doShare">{{item.shared ? '已晒单' : '晒单 +' + shareReturn + ' 功德'}}</view>
          </view>
        </view>
      </view>
      <view class="col">
        <view class="pd" wx:for="{{list}}" wx:key="id" wx:if="{{index % 2 === 1}}" data-index="{{index}}" bindtap="exchange">
          <view class="img" style="background:{{item.bg}}"><astro name="{{item.cover}}" size="72" theme="dark"/><view class="badge {{item.badgeCls}}" wx:if="{{item.badgeText}}">{{item.badgeText}}</view></view>
          <view class="body">
            <view class="tt">{{item.title}}</view>
            <view class="pr"><text class="price">{{item.cost}} 功德</text><text class="mtag" wx:if="{{item.meritTag}}">{{item.meritTag}}</text></view>
            <view class="sl">{{item.sales}}</view>
            <view class="buy">立即购买</view>
            <view class="share-btn {{item.shared ? 'done' : ''}}" wx:if="{{item.shareable}}" data-index="{{index}}" catchtap="doShare">{{item.shared ? '已晒单' : '晒单 +' + shareReturn + ' 功德'}}</view>
          </view>
        </view>
      </view>
  </view>
  <view class="disclaimer">商城好物以功德兑换，零金钱交易；功德不可购、不可提现、不可兑。本平台内容仅供娱乐参考，请勿迷信。</view>
</view>
