.page { padding: 0 0 40rpx; }
.search { margin: 16rpx 24rpx 8rpx; background: var(--bg-elev); border-radius: 999rpx; height: 72rpx; display: flex; align-items: center; padding: 0 26rpx; color: var(--fg-2); font-size: 26rpx; }
.cats { white-space: nowrap; padding: 6rpx 24rpx 16rpx; }
.cat { display: inline-block; font-size: 26rpx; padding: 14rpx 28rpx; border-radius: 999rpx; background: var(--bg-elev); color: var(--fg-2); margin-right: 14rpx; }
.cat.on { background: var(--gold); color: #fff; }

.feed { display: flex; padding: 6rpx 16rpx 0; gap: 12rpx; }
.col { flex: 1; }
.pd { background: var(--card); border-radius: 24rpx; margin-bottom: 12rpx; overflow: hidden; box-shadow: var(--shadow-sm); }
.pd .img { height: 300rpx; display: flex; align-items: center; justify-content: center; font-size: 80rpx; color: #fff; position: relative; }
.pd .badge { position: absolute; top: 16rpx; left: 16rpx; background: rgba(0,0,0,.42); color: #fff; font-size: 20rpx; padding: 4rpx 16rpx; border-radius: 999rpx; }
.pd .body { padding: 16rpx 18rpx 18rpx; }
.pd .tt { font-size: 27rpx; line-height: 1.4; color: var(--fg); font-weight: 500; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.pd .pr { display: flex; align-items: baseline; gap: 12rpx; margin-top: 14rpx; }
.pd .price { color: var(--gold-deep); font-size: 32rpx; font-weight: 700; }
.pd .mtag { font-size: 20rpx; color: var(--gold-deep); background: var(--gold-tint); padding: 2rpx 12rpx; border-radius: 8rpx; }
.pd .sl { font-size: 22rpx; color: var(--fg-2); margin-top: 10rpx; }
.pd .buy { margin-top: 16rpx; background: var(--gold); color: #fff; text-align: center; border-radius: 999rpx; padding: 18rpx; font-size: 26rpx; }

/* ===== 文旅打卡 P0：折扣券 / 优先购提示条（令牌驱动，明暗自适应）===== */
.coupon-strip { margin: 12rpx 24rpx 4rpx; font-size: 22rpx; color: var(--gold-deep);
  background: var(--gold-soft); border: 1rpx solid rgba(200, 163, 90, .22);
  border-radius: 14rpx; padding: 14rpx 20rpx; line-height: 1.6; }
.priority-strip { margin: 4rpx 24rpx 0; font-size: 22rpx; color: #fff;
  background: linear-gradient(135deg, #c8a35a, #8a6a2a); border-radius: 14rpx; padding: 14rpx 20rpx; }
.pd .badge-prio { background: linear-gradient(135deg, #c8a35a, #8a6a2a); color: #fff; font-weight: 700; }
