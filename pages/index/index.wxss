/* ===== 首页 · 方向 C：仪式流 · 极简减法 =====
   核心减法：快捷入口 + 三步成习 → 一条「今日仪式」竖流；
   完整万年历 → 本周星历周条；宜忌内联进 Hero。令牌同源。 */

.page { padding: 0 0 40rpx; background: var(--bg); }

/* 搜索胶囊（极简） */
.search { margin: 20rpx 32rpx 8rpx; background: var(--bg-elev); border: 1rpx solid var(--border); border-radius: 999rpx; height: 76rpx; display: flex; align-items: center; gap: 14rpx; padding: 0 30rpx; color: var(--fg-2); font-size: 26rpx; }
.search:active { background: var(--card); }

/* 吸顶 Tab */
.tabs-wrap { position: sticky; top: 0; z-index: 20; background: var(--bg); padding-top: 8rpx; }
.tabs { display: flex; gap: 44rpx; padding: 14rpx 36rpx 18rpx; border-bottom: 1rpx solid var(--border); }
.tabs .t { font-size: 32rpx; color: var(--fg-2); position: relative; padding-bottom: 12rpx; }
.tabs .t.on { color: var(--fg); font-weight: 700; }
.tabs .t.on::after { content: ""; position: absolute; left: 50%; bottom: 0; transform: translateX(-50%); width: 36rpx; height: 6rpx; border-radius: 6rpx; background: var(--gold); }

/* 首屏骨架屏 */
.sk { padding: 24rpx 20rpx 0; }
.sk-row { display: flex; gap: 14rpx; }
.sk-card { flex: 1; background: var(--card); border-radius: 24rpx; overflow: hidden; box-shadow: var(--shadow-sm); }
.sk-img { height: 200rpx; background: linear-gradient(100deg,var(--card) 30%,var(--bg-elev) 50%,var(--card) 70%); background-size: 200% 100%; animation: sk 1.1s infinite; }
.sk-l1 { height: 22rpx; margin: 16rpx 18rpx 0; border-radius: 6rpx; background: var(--card); }
.sk-l2 { height: 22rpx; margin: 10rpx 18rpx 0; width: 60%; border-radius: 6rpx; background: var(--card); }
@keyframes sk { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }

/* 空状态 */
.empty { text-align: center; padding: 80rpx 40rpx; }
.em-mark { font-size: 64rpx; color: var(--gold); }
.em-tt { font-size: 30rpx; font-weight: 700; color: var(--fg); margin-top: 18rpx; }
.em-sub { font-size: 24rpx; color: var(--fg-2); margin-top: 12rpx; line-height: 1.7; }

/* 回到顶部 */
.to-top { position: fixed; right: 28rpx; bottom: 150rpx; width: 84rpx; height: 84rpx; border-radius: 50%; background: rgba(31,28,23,.82); color: var(--gold-tint); font-size: 24rpx; display: flex; align-items: center; justify-content: center; z-index: 60; box-shadow: 0 6rpx 20rpx rgba(0,0,0,.25); }

/* ===== Hero：唯一深色沉浸区（C：更高留白，宜忌内联） ===== */
.hero { margin: 12rpx 32rpx 28rpx; border-radius: 40rpx; padding: 44rpx 36rpx 40rpx; color: #f6eccb; background: var(--night-grad); position: relative; overflow: hidden; }
.hero.tall { padding: 48rpx 36rpx 40rpx; }
.hero .stars { position: absolute; inset: 0; background-image: radial-gradient(2rpx 2rpx at 18% 22%, rgba(255,255,255,.85), transparent), radial-gradient(2rpx 2rpx at 68% 16%, rgba(255,255,255,.7), transparent), radial-gradient(2rpx 2rpx at 86% 56%, rgba(255,255,255,.6), transparent), radial-gradient(2rpx 2rpx at 40% 78%, rgba(255,255,255,.7), transparent); opacity: .75; }
.hero-inner { position: relative; z-index: 2; }
.hero-eyebrow { font-size: 20rpx; letter-spacing: 4rpx; opacity: .82; margin-bottom: 14rpx; font-weight: 600; }
.b-title { font-family: "Source Han Serif SC","Songti SC",serif; font-size: 46rpx; font-weight: 700; letter-spacing: 2rpx; line-height: 1.42; margin-top: 6rpx; }
.hero.tall .b-title { font-size: 50rpx; }
/* C：宜忌内联（排印，非 emoji） */
.poetic { font-size: 26rpx; opacity: .85; line-height: 1.7; margin-top: 16rpx; letter-spacing: 1rpx; }
.hero-meta { display: flex; justify-content: space-between; align-items: flex-end; margin-top: 32rpx; position: relative; z-index: 2; }
.hm-l { display: flex; flex-direction: column; }
.hm-solar { font-size: 26rpx; opacity: .95; }
.hm-lunar { font-size: 22rpx; opacity: .8; margin-top: 6rpx; }
.hm-weather { text-align: right; }
.hw-temp { display: block; font-size: 44rpx; font-weight: 700; line-height: 1; }
.hw-cond { font-size: 22rpx; opacity: .8; margin-top: 6rpx; }
.lamp { margin-top: 34rpx; display: inline-flex; align-items: center; gap: 12rpx; background: rgba(246,236,203,.16); border: 1rpx solid rgba(246,236,203,.4); padding: 18rpx 32rpx; border-radius: 999rpx; font-size: 26rpx; position: relative; z-index: 2; }
.lamp:active { background: rgba(246,236,203,.24); }

/* ===== 今日仪式 · 极简竖流 ===== */
.ritual { margin: 8rpx 32rpx 0; }
.rstep { display: flex; gap: 22rpx; align-items: flex-start; position: relative; padding: 28rpx 4rpx; }
.rstep:not(:last-child)::before { content: ""; position: absolute; left: 37rpx; top: 78rpx; bottom: -2rpx; width: 2rpx; background: var(--gold-soft); }
.r-ic { width: 76rpx; height: 76rpx; border-radius: 50%; background: var(--bg-elev); border: 1rpx solid var(--border); display: flex; align-items: center; justify-content: center; flex: none; }
.r-main { flex: 1; min-width: 0; }
.r-t { font-size: 30rpx; font-weight: 700; color: var(--fg); }
.r-d { font-size: 24rpx; color: var(--fg-2); margin-top: 6rpx; line-height: 1.55; }
.r-badge { align-self: center; font-size: 22rpx; color: var(--gold-deep); background: var(--gold-soft); border-radius: 999rpx; padding: 8rpx 18rpx; flex: none; }
.r-arrow { align-self: center; font-size: 30rpx; color: var(--gold-deep); flex: none; }

/* ===== 距深度解读进度：细线 ===== */
.unlock-chip { margin: 36rpx 32rpx 0; display: flex; align-items: center; gap: 18rpx; padding: 6rpx 0; }
.unlock-chip .uc-l { font-size: 24rpx; color: var(--fg-3); white-space: nowrap; }
.unlock-chip .uc-bar { flex: 1; height: 10rpx; background: rgba(138,127,109,.2); border-radius: 10rpx; overflow: hidden; }
.unlock-chip .uc-fill { height: 100%; background: linear-gradient(90deg, var(--gold), var(--gold-deep)); border-radius: 10rpx; transition: width .8s cubic-bezier(.2,.8,.2,1); }
.unlock-chip .uc-r { font-size: 22rpx; color: var(--gold-deep); font-weight: 700; min-width: 64rpx; text-align: right; }

/* ===== 本周星历 · 周条（替代完整万年历） ===== */
.cal-week-strip { margin: 36rpx 32rpx 0; }
.cws-head { font-size: 24rpx; color: var(--fg-2); margin-bottom: 16rpx; letter-spacing: 1rpx; }
.strip { display: flex; gap: 10rpx; }
.sday { flex: 1; text-align: center; padding: 18rpx 0; border-radius: 16rpx; background: var(--card); border: 1rpx solid var(--border); }
.sday.dim { opacity: .35; }
.sday.today { background: var(--gold-soft); border-color: transparent; }
.sday .sd { font-size: 28rpx; font-weight: 600; color: var(--fg); }
.sday.today .sd { color: var(--gold-deep); }
.sday .sl { font-size: 18rpx; color: var(--fg-2); opacity: .7; margin-top: 6rpx; }

/* ===== 瀑布流：更轻的卡片 ===== */
.feed { display: flex; padding: 22rpx 20rpx 0; gap: 14rpx; }
.col { flex: 1; }
.card { background: var(--card); border-radius: 26rpx; margin-bottom: 14rpx; overflow: hidden; box-shadow: var(--shadow-sm); border: 1rpx solid var(--border); }
.card .img { width: 100%; display: flex; align-items: center; justify-content: center; position: relative; }
.card .img-ic { width: 64rpx; height: 64rpx; opacity: .85; }
.card .body { padding: 18rpx 20rpx 20rpx; }
.card .tt { font-size: 27rpx; line-height: 1.45; color: var(--fg); font-weight: 500; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.card .meta { display: flex; align-items: center; gap: 10rpx; margin-top: 14rpx; font-size: 22rpx; color: var(--fg-2); }
.card .meta .av { width: 34rpx; height: 34rpx; border-radius: 50%; background: var(--gold-soft); display: flex; align-items: center; justify-content: center; font-size: 20rpx; color: var(--gold-deep); }
.card .meta .nm { flex: 1; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.card .meta .acts { display: flex; gap: 10rpx; flex-shrink: 0; }
.card .meta .act { font-size: 20rpx; color: var(--fg-2); padding: 4rpx 12rpx; border-radius: 999rpx; background: var(--bg-elev); }
.card .meta .act.on { color: var(--gold-deep); background: var(--gold-soft); font-weight: 700; }
.mine-flag { position: absolute; left: 12rpx; top: 12rpx; background: rgba(200,163,90,.92); color: #fff; font-size: 18rpx; padding: 4rpx 14rpx; border-radius: 999rpx; }

/* ===== 关注分屏 · 头像行 ===== */
.follow-bar { white-space: nowrap; padding: 10rpx 32rpx 0; }
.fb { display: inline-flex; flex-direction: column; align-items: center; margin-right: 32rpx; }
.fb-av { width: 88rpx; height: 88rpx; border-radius: 50%; background: linear-gradient(140deg, var(--gold), #e0c489); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 34rpx; }
.fb-nm { font-size: 22rpx; color: var(--fg-3); margin-top: 8rpx; max-width: 96rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.fb-btn { font-size: 18rpx; color: var(--gold-deep); margin-top: 6rpx; border: 1rpx solid var(--gold); padding: 4rpx 18rpx; border-radius: 999rpx; }
.fb-btn.on { color: #fff; background: var(--gold); }

/* ===== 推荐关注条 ===== */
.rec { margin: 18rpx 32rpx 4rpx; background: var(--card); border: 1rpx solid var(--border); border-radius: 22rpx; padding: 20rpx 22rpx 18rpx; box-shadow: var(--shadow-sm); }
.rec-h { font-size: 23rpx; color: var(--fg-2); margin-bottom: 16rpx; }
.rec-bar { white-space: nowrap; }
.rc { display: inline-block; width: 150rpx; text-align: center; vertical-align: top; }
.rc-av { width: 84rpx; height: 84rpx; border-radius: 50%; background: linear-gradient(140deg, var(--gold-soft), var(--gold-tint)); display: flex; align-items: center; justify-content: center; font-size: 38rpx; margin: 0 auto; }
.rc-nm { display: block; font-size: 22rpx; color: var(--fg); margin-top: 10rpx; max-width: 140rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.rc-btn { display: inline-block; margin-top: 10rpx; font-size: 22rpx; color: #fff; background: var(--gold); border-radius: 999rpx; padding: 6rpx 22rpx; }
.rc-btn:active { opacity: .85; }

/* ===== 视频分屏 ===== */
.vfeed { padding: 22rpx 32rpx 0; }
.vcard { background: var(--card); border-radius: 26rpx; margin-bottom: 18rpx; overflow: hidden; box-shadow: var(--shadow-sm); border: 1rpx solid var(--border); }
.v-cover { position: relative; height: 320rpx; display: flex; align-items: center; justify-content: center; }
.v-ic { width: 80rpx; height: 80rpx; opacity: .8; }
.v-play { position: absolute; left: 50%; top: 50%; transform: translate(-50%,-50%); width: 84rpx; height: 84rpx; border-radius: 50%; background: rgba(0,0,0,.35); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 34rpx; padding-left: 6rpx; }
.v-dur { position: absolute; right: 16rpx; bottom: 16rpx; background: rgba(0,0,0,.5); color: #fff; font-size: 20rpx; padding: 4rpx 12rpx; border-radius: 999rpx; }
.v-topic { position: absolute; left: 16rpx; top: 16rpx; background: rgba(200,163,90,.92); color: #fff; font-size: 20rpx; padding: 4rpx 14rpx; border-radius: 999rpx; }
.v-body { padding: 18rpx 22rpx 22rpx; }
.v-tt { font-size: 28rpx; font-weight: 500; color: var(--fg); line-height: 1.45; }
.v-meta { display: flex; justify-content: space-between; align-items: center; margin-top: 12rpx; font-size: 22rpx; color: var(--fg-2); }
.v-meta .acts { display: flex; align-items: center; gap: 14rpx; }
.v-meta .act { font-size: 20rpx; color: var(--fg-2); }
.v-meta .act.on { color: var(--gold-deep); font-weight: 700; }
.v-plays { color: var(--fg-2); }

/* ===== 随手记一笔 ===== */
.quickpost { display: flex; gap: 14rpx; margin: 18rpx 0 8rpx; align-items: center; }
.qp-input { flex: 1; height: 68rpx; background: var(--card); border: 1rpx solid var(--border); border-radius: 34rpx; padding: 0 24rpx; font-size: 26rpx; color: var(--fg-3); }
.qp-btn { flex: none; height: 68rpx; line-height: 68rpx; padding: 0 28rpx; background: var(--gold-grad); color: #3a2c10; border-radius: 34rpx; font-size: 26rpx; font-weight: 600; }

/* ===== 首次启动引导 overlay ===== */
.guide { position: fixed; inset: 0; z-index: 900; display: flex; align-items: center; justify-content: center; }
.guide-mask { position: absolute; inset: 0; background: rgba(20,16,12,.62); }
.guide-card { position: relative; width: 620rpx; max-width: 86vw; background: var(--card); border-radius: 32rpx; padding: 48rpx 40rpx 36rpx; text-align: center; box-shadow: var(--shadow-md); }
.g-emoji { font-size: 64rpx; color: var(--gold); }
.g-title { font-size: 38rpx; font-weight: 700; margin-top: 14rpx; color: var(--fg); }
.g-sub { font-size: 25rpx; color: var(--fg-2); margin-top: 10rpx; }
.g-grid { display: flex; flex-wrap: wrap; gap: 18rpx; margin: 32rpx 0 30rpx; }
.g-item { width: calc(33.33% - 12rpx); background: var(--bg-elev); border: 1rpx solid var(--border); border-radius: 20rpx; padding: 22rpx 8rpx; }
.g-ic { width: 48rpx; height: 48rpx; margin: 0 auto; display: flex; align-items: center; justify-content: center; }
.g-t { font-size: 25rpx; font-weight: 700; color: var(--fg); margin-top: 10rpx; }
.g-d { font-size: 19rpx; color: var(--fg-2); margin-top: 4rpx; line-height: 1.4; }
.g-btn { background: linear-gradient(135deg, var(--gold), #e0c489); color: #fff; border-radius: 999rpx; padding: 24rpx; font-size: 28rpx; font-weight: 700; box-shadow: var(--shadow-md); }
.g-btn:active { filter: brightness(.96); }
.g-skip { font-size: 24rpx; color: var(--fg-2); margin-top: 20rpx; }
.g-wish-t { margin: 26rpx 0 12rpx; font-size: 24rpx; color: var(--fg-2); }
.g-wishes { display: flex; flex-wrap: wrap; gap: 14rpx; justify-content: center; }
.gw { display: flex; align-items: center; gap: 8rpx; padding: 12rpx 18rpx; background: var(--bg-elev); border: 1rpx solid var(--border); border-radius: 999rpx; font-size: 24rpx; color: var(--fg-3); }
.gw-ic { width: 32rpx; height: 32rpx; display: flex; align-items: center; justify-content: center; }
.gw.on { border-color: var(--gold); background: var(--gold-soft); color: var(--gold-deep); font-weight: 700; }

/* ===== 入场「开窗」动画 ===== */
.win-open { position: fixed; inset: 0; z-index: 950; overflow: hidden; pointer-events: none; }
.wo-pane { position: absolute; top: 0; bottom: 0; width: 50.5%; background: linear-gradient(165deg, #f3ecdd 0%, #e7dcc4 55%, #dcc9a4 100%); z-index: 3; }
.wo-left { left: 0; transform-origin: left center; border-right: 2rpx solid rgba(200,163,90,.55); animation: woOpenL 1s cubic-bezier(.76,0,.24,1) .15s forwards; }
.wo-right { right: 0; transform-origin: right center; border-left: 2rpx solid rgba(200,163,90,.55); animation: woOpenR 1s cubic-bezier(.76,0,.24,1) .15s forwards; }
.wo-left::after, .wo-right::after { content: ""; position: absolute; top: 0; bottom: 0; width: 64rpx; background: repeating-linear-gradient(180deg, rgba(160,130,80,.18) 0 2rpx, transparent 2rpx 120rpx); }
.wo-left::after { right: 18rpx; }
.wo-right::after { left: 18rpx; }
@keyframes woOpenL { to { transform: translateX(-100%); } }
@keyframes woOpenR { to { transform: translateX(100%); } }
.wo-glow { position: absolute; inset: 0; z-index: 1; background: radial-gradient(120% 80% at 50% 42%, rgba(255,225,150,.55), rgba(200,163,90,.12) 40%, transparent 70%); animation: woGlow 1.2s ease forwards; }
@keyframes woGlow { 0%, 30% { opacity: 0; } 60% { opacity: 1; } 100% { opacity: .35; } }
.wo-stars { position: absolute; inset: 0; z-index: 2; }
.wo-star { position: absolute; width: 8rpx; height: 8rpx; border-radius: 50%; background: radial-gradient(circle, #fff 0%, #ffe9a8 55%, transparent 70%); box-shadow: 0 0 10rpx #ffe9a8; opacity: 0; animation: woTwinkle 1.4s ease-in-out infinite; }
@keyframes woTwinkle { 0%, 100% { opacity: .2; transform: scale(.7); } 50% { opacity: 1; transform: scale(1.2); } }
.wo-center { position: absolute; left: 0; right: 0; top: 42%; z-index: 4; text-align: center; transform: translateY(-50%); animation: woFade 1.1s ease forwards; }
.wo-mark { font-size: 88rpx; color: var(--gold-deep); text-shadow: 0 0 30rpx rgba(200,163,90,.6); }
.wo-name { margin-top: 12rpx; font-size: 34rpx; font-weight: 700; color: var(--gold-deep); letter-spacing: 4rpx; }
@keyframes woFade { 0% { opacity: 0; transform: translateY(-50%) scale(.96); } 25% { opacity: 1; } 70% { opacity: 1; } 100% { opacity: 0; transform: translateY(-50%) scale(1.02); } }

/* 深色夜灯：窗扉转深蓝描金 */
.page.dark .wo-pane { background: linear-gradient(165deg, #16243f 0%, #0f1c33 55%, #0a1426 100%); border-color: rgba(217,182,106,.5); }
.page.dark .wo-left::after, .page.dark .wo-right::after { background: repeating-linear-gradient(180deg, rgba(217,182,106,.16) 0 2rpx, transparent 2rpx 120rpx); }
.page.dark .wo-mark, .page.dark .wo-name { color: var(--gold); text-shadow: 0 0 30rpx rgba(217,182,106,.7); }

/* 尊重系统「减少动态效果」 */
@media (prefers-reduced-motion: reduce) {
  .win-open { display: none !important; }
}
